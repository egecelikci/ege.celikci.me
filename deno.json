{
  "imports": {
    "@shikijs/rehype": "npm:@shikijs/rehype@^4.4.3",
    "@shikijs/themes": "npm:@shikijs/themes@^4.4.3",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "@types/leaflet": "npm:@types/leaflet@^1.9.22",
    "instant.page": "npm:instant.page@^5.2.0",
    "leaflet": "npm:leaflet@^1.9.4",
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.3.1/",
    "lume/cms/": "https://cdn.jsdelivr.net/gh/lumeland/cms@0.15.8/",
    "photoswipe": "npm:photoswipe@^5.4.4",
    "rehype-autolink-headings": "npm:rehype-autolink-headings@^7.1.0",
    "rehype-slug": "npm:rehype-slug@^6.0.0",
    "remark-gfm": "npm:remark-gfm@^4.0.1",
    "remark-smartypants": "npm:remark-smartypants@^3.0.3",
    "remark-toc": "npm:remark-toc@^9.0.0",
    "sharp": "npm:sharp@^0.35.4",
    "shiki": "npm:shiki@^4.4.3",
    "typst": "https://cdn.jsdelivr.net/gh/lumeland/experimental-plugins@babfcbd6550cd8cf0069b6ca53f2558a2d9566fc/typst/mod.ts",
    "serwist": "npm:serwist@^9.5.12",
    "@serwist/cli": "npm:@serwist/cli@^9.5.12",
    "xss": "npm:xss@^1.0.15",
    "lume/jsx-runtime": "https://cdn.jsdelivr.net/gh/oscarotero/ssx@0.1.15/jsx-runtime.ts",
    "zod": "npm:zod@^4.4.3"
  },
  "tasks": {
    "lume": {
      "description": "Run Lume command",
      "command": "deno run -A lume/cli.ts"
    },
    "build": {
      "description": "Build the site for production",
      "command": "MODE=production deno task lume"
    },
    "serve": {
      "description": "Run and serve the site for development",
      "command": "MODE=development deno task lume -s"
    },
    "deploy": {
      "description": "Build locally and publish to Netlify",
      "command": "deno task build && netlify deploy --prod"
    },
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check _config.ts utils/**/*.ts src/*.page.ts",
    "test": "deno test utils/",
    "wasmbuild": "cd src/_rust/collage && deno run -A jsr:@deno/wasmbuild --inline --out lib",
    "new": {
      "description": "Create new content or code using artifacts",
      "command": "deno task lume new"
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "json.trailingCommas": "never",
    "include": [
      "src/",
      "_config/",
      "utils/",
      "netlify/"
    ],
    "exclude": [
      "src/_data/music.json",
      "src/_data/mb_events.json"
    ]
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts",
      "./_config/types.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "lume"
  },
  "unstable": [
    "temporal",
    "fmt-component"
  ],
  "lint": {
    "plugins": [
      "https://cdn.jsdelivr.net/gh/lumeland/lume@3.3.1/lint.ts"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "lock": true,
  "permissions": {
    "lume": {
      "read": true,
      "write": [
        "./"
      ],
      "import": [
        "cdn.jsdelivr.net:443",
        "jsr.io:443",
        "deno.land:443",
        "esm.sh:443"
      ],
      "net": [
        "0.0.0.0",
        "cdn.jsdelivr.net:443",
        "data.jsdelivr.com:443",
        "jsr.io:443",
        "deno.land:443",
        "esm.sh:443",
        "registry.npmjs.org:443"
      ],
      "env": true,
      "run": true,
      "ffi": true,
      "sys": true
    }
  },
  "allowScripts": [
    "npm:sharp"
  ],
  "nodeModulesDir": "auto"
}