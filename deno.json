{
  "imports": {
    "@shikijs/rehype": "npm:@shikijs/rehype@^4.5.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@types/leaflet": "npm:@types/leaflet@^1.9.22",
    "leaflet": "npm:leaflet@^1.9.4",
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.3.3/",
    "lume/cms/": "https://cdn.jsdelivr.net/gh/lumeland/cms@0.15.9/",
    "photoswipe": "npm:photoswipe@^5.4.4",
    "protomaps-leaflet": "npm:protomaps-leaflet@5.1.0",
    "rehype-autolink-headings": "npm:rehype-autolink-headings@^7.1.0",
    "rehype-slug": "npm:rehype-slug@^6.0.0",
    "remark-gfm": "npm:remark-gfm@^4.0.1",
    "remark-smartypants": "npm:remark-smartypants@^3.0.3",
    "remark-toc": "npm:remark-toc@^9.0.0",
    "sharp": "npm:sharp@^0.35.5",
    "typst": "https://cdn.jsdelivr.net/gh/lumeland/experimental-plugins@babfcbd6550cd8cf0069b6ca53f2558a2d9566fc/typst/mod.ts",
    "serwist": "npm:serwist@^9.5.13",
    "@serwist/cli": "npm:@serwist/cli@^9.5.13",
    "xss": "npm:xss@^1.0.17",
    "zod": "npm:zod@^4.6.7"
  },
  "tasks": {
    "lume": {
      "description": "Run Lume command",
      "command": "deno run -A lume/cli.ts"
    },
    "build": {
      "description": "Build the site for production",
      "command": "MODE=production deno task lume"
    },
    "serve": {
      "description": "Run and serve the site for development",
      "command": "MODE=development deno task lume -s"
    },
    "deploy": {
      "description": "Run the checks, build locally, and publish to Netlify",
      "command": "deno task ci && deno task build && netlify deploy --prod"
    },
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check _config.ts _config/ _cms.ts sw.ts utils/ jobs/ tools/ src/ netlify/",
    "test": "deno test --allow-read utils/ jobs/",
    "lint": "deno lint",
    "hooks": {
      "description": "Install the pre-commit hook that runs the ci checks",
      "command": "deno run --allow-run=git --allow-read --allow-write tools/install-hooks.ts"
    },
    "ci": {
      "description": "Formatting, lint, types, and tests, fastest first; the pre-commit hook and deploys run this",
      "command": "deno task fmt:check && deno task lint && deno task check && deno task test"
    },
    "tiles": {
      "description": "Refresh the map tile extract from Protomaps",
      "command": "deno run -A jobs/tiles.ts"
    },
    "wasmbuild": "cd src/_rust/collage && deno run -A jsr:@deno/wasmbuild --inline --out lib",
    "new": {
      "description": "Create new content or code using artifacts",
      "command": "deno task lume new"
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "json.trailingCommas": "never",
    "include": [
      "src/",
      "_config/",
      "utils/",
      "netlify/"
    ],
    "exclude": [
      "src/_data/*.json",
      "**/*.vto"
    ]
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts",
      "./_config/types.ts"
    ]
  },
  "unstable": [
    "temporal",
    "fmt-component"
  ],
  "lint": {
    "plugins": [
      "https://cdn.jsdelivr.net/gh/lumeland/lume@3.3.3/lint.ts"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  },
  "lock": true,
  "allowScripts": [
    "npm:sharp"
  ],
  "nodeModulesDir": "auto"
}
