---
layout: layouts/base.vto
---

{{ set pageBody }}
  {{ if it.hide_title !== true }}
    {{ await comp.layout.PageHeader(it) }}
  {{ /if }}

  {{ if it.search_bar && !it.hide_layout_search }}
    <div class="page-search">
      {{ if it.search_bar.label }}
        <div class="page-search__label-row">
          <span class="page-search__label typography-label">
            {{ it.search_bar.label }}
          </span>
        </div>
      {{ /if }}
      {{
        await comp.features.Search({
          compId: it.search_bar.id || "page-search",
          ...it.search_bar,
        })
      }}
    </div>
  {{ /if }}

  <{{ (it.type === "note" || it.prose === false) ? "div" : "article" }}
  class="{{ (it.type !== "note" && it.prose !== false) ? "h-entry markdown" : "" }} {{ it.hide_title !== true ? "page-content" : "page-content page-content--bare" }} {{ it.article_classes || "" }}"
  {{ if it.searchable !== false }}data-pagefind-body{{ /if }}
  >
  {{ if it.type === "note" }}
    {{ if !it.title }}
      <span
  data-pagefind-meta="title:note from {{ it.date |> date('dd MMM yyyy HH:mm') }}"
  class="sr-only"
></span>
    {{ /if }}

    {{
      await comp.ui.Note({
        note: {
          url: url,
          date: date,
          title: it.title,
          tags: tags,
          images: images,
          content: content,
          stats: stats,
          syndication: syndication,
        },
        variant: "full",
        hideHeader: true,
      })
    }}
  {{ else if it.type === "tag" }}
    <div class="sr-only" data-pagefind-body>
      {{ it.title }} tag topic index. collection of items related to {{ it.tag }}.
    </div>
    {{ await comp.ui.TagDetail({ tag: it.tag }) }}
  {{ else }}
    <div class="{{ (it.prose !== false) ? " e-content" : "" }}">
      {{ content |> safe }}
    </div>
  {{ /if }}

  <div
  class="p-author h-card hidden"
  data-pagefind-ignore=""
>
  <a href="/" class="u-url p-name">{{ it.author.name }}</a>
</div>
  </{{ (it.type === "note" || it.prose === false) ? "div" : "article" }}>

  {{
    set backlinksBlock = await comp.ui.IncomingLinks({ backlinks: backlinks })
  }}

  {{ set mentionsData = [] }}
  {{ if show_webmentions }}
    {{ if webmentions }}
      {{
        set mentionsData = webmentions.children
        |> webmentionsByUrl(url, syndication)
      }}
    {{ /if }}
  {{ /if }}

  {{
    await comp.layout.PageFooter({
      ...it,
      interactions: mentionsData,
      backlinks: backlinksBlock,
    })
  }}
{{ /set }}

{{
  await comp.layout.Container({
    width: it.container_width || "narrow",
    classes: "page-body",
    content: pageBody,
  })
}}
