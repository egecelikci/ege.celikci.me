---
layout: layouts/page.vto
extraStyles:
  - leaflet
---

{{>
  const posterImages = it.event.imagePath
    ? [{ src: it.event.imagePath, alt: it.event.name }]
    : (it.event.posterUrl
      ? [{ src: it.event.posterUrl, alt: it.event.name }]
      : [])
}}

<div class="event-page">
  <div class="event-page__grid">
    <div class="event-page__content">
      <section class="event-page__header">
        {{ if event.isCustomTitle && event.displayTitle }}
          <p class="event-page__custom-title">
            {{ event.displayTitle }}
          </p>
        {{ /if }}

        {{ if event.disambiguation }}
          <p class="event-page__disambiguation">
            {{ event.disambiguation }}
          </p>
        {{ /if }}

        {{ if event.labels?.length > 0 }}
          <div class="event-page__organizers">
            {{ for labelRel of event.labels }}
              <div class="event-page__organizer">
                <span class="event-page__organizer-label typography-label">Presented by</span>
                <div class="event-page__organizer-main">
                  <span class="event-page__organizer-name">{{ labelRel["target-credit"] || labelRel.label.name }}</span>
                  <div class="event-page__organizer-links">
                    {{
                      comp.base.ExternalLinks({
                        links: labelRel.label.externalLinks,
                        showFallbacks: false,
                      })
                    }}
                  </div>
                </div>
              </div>
            {{ /for }}
          </div>
        {{ /if }}

        <div class="event-page__meta-row">
          <div class="event-page__meta-col">
            {{ comp.ui.SectionHeader({ title: "Date & Time" }) }}
            <div class="event-page__meta-value">
              {{ if it.event.beginDate }}
                {{ it.event.beginDate |> date("EEE, MMM dd") }}
                {{ if it.event.time }}
                  <span class="event-page__meta-time">{{ it.event.time }}</span>
                {{ /if }}
              {{ else }}
                TBA
              {{ /if }}
            </div>
          </div>

          {{ if event.local?.price }}
            <div class="event-page__meta-col event-page__meta-col--fee">
              {{ comp.ui.SectionHeader({ title: "Entry Fee" }) }}
              <div class="event-page__meta-value event-page__meta-value--fee">
                {{ event.local.price }}
              </div>
            </div>
          {{ /if }}
        </div>

        {{ if event.local?.description }}
          <div class="event-page__description markdown">
            {{ event.local.description }}
          </div>
        {{ /if }}

        {{ if event.local?.video }}
          <div class="event-page__video">
            {{
              comp.ui.Video({
                src: event.local.video.src,
                title: event.local.video.title,
                credits: videoCredits,
              })
            }}
          </div>
        {{ /if }}
      </section>

      <div class="event-page__lineup">
        <section class="event-page__section">
          {{ comp.ui.SectionHeader({ title: "Lineup" }) }}
          {{
            set artistRels = (event.relations || []).filter((r) =>
              r["target-type"] === "artist" &&
              !["illustration", "graphic design", "artwork", "design", "engineer"].includes(
                r.type,
              )
            )
          }}
          {{ if artistRels.length > 0 }}
            <ul class="event-page__artist-list">
              {{ for rel of artistRels }}
                <li class="event-page__artist">
                  <div class="event-page__artist-name">
                    <a
                      href="https://musicbrainz.org/artist/{{ rel.artist.id }}"
                      class="event-page__artist-link"
                    >
                      {{ rel["target-credit"] || rel.artist.name }}
                    </a>

                    <div class="event-page__artist-links">
                      {{
                        comp.base.ExternalLinks({
                          links: rel.artist.externalLinks,
                          showFallbacks: false,
                        })
                      }}
                    </div>
                  </div>
                  <span class="event-page__artist-role typography-label">
                    {{ rel.type }}
                  </span>
                </li>
              {{ /for }}
            </ul>
          {{ else }}
            <p class="event-page__tba">Lineup TBA</p>
          {{ /if }}
        </section>

        {{ if event.setlist }}
          <section class="event-page__section">
            {{ comp.ui.SectionHeader({ title: "Setlist" }) }}
            {{
              await it.comp.ui.Setlist({
                content: event.setlist,
              })
            }}
          </section>
        {{ /if }}
      </div>
    </div>

    <aside class="event-page__sidebar">
      {{ if posterImages.length > 0 }}
        <div>
          {{ await comp.ui.Media({ images: posterImages, aspect: "auto", card: true }) }}

          {{ if posterCredits?.length > 0 }}
            <div class="media-credits media-credits--poster">
              {{ for credit of posterCredits }}
                <div class="media-credits__row">
                  <span class="media-credits__label">{{ credit.role }}</span>
                  <a
                    href="{{ credit.url }}"
                    target="_blank"
                    class="media-credits__name"
                  >
                    {{ credit.name }}
                  </a>
                </div>
              {{ /for }}
            </div>
          {{ /if }}
        </div>
      {{ /if }}

      <section class="event-page__section">
        {{ comp.ui.SectionHeader({ title: "Venue" }) }}
        {{
          set venueRel = (event.relations || []).find((r) => r["target-type"] === "place")
        }}
        {{ if venueRel }}
          <div class="event-page__venue-body">
            <div class="event-page__venue-header">
              <div class="event-page__venue-name">
                <span class="event-page__venue-name-text">{{ event.venueName }}</span>

                <div class="event-page__venue-links">
                  {{
                    comp.base.ExternalLinks({
                      links: venueRel.place.externalLinks,
                      showFallbacks: false,
                    })
                  }}
                </div>
              </div>
              {{ if venueRel.place.address }}
                <p class="event-page__venue-address">
                  {{ venueRel.place.address }}
                </p>
              {{ /if }}
            </div>

            {{ if venueRel.place.coordinates }}
              <div class="event-page__map">
                <div class="event-page__map-square">
                  <div
                    class="venue-map"
                    data-lat="{{ venueRel.place.coordinates.latitude }}"
                    data-lng="{{ venueRel.place.coordinates.longitude }}"
                    data-name="{{ event.venueName }}"
                  >
                  </div>
                  <div class="event-page__map-overlay">
                  </div>
                </div>

                <div class="event-page__map-nav">
                  <div
                    class="event-page__map-menu menu menu--divided"
                    role="menu"
                  >
                    <a
                      href='geo:{{ venueRel.place.coordinates.latitude }},{{ venueRel.place.coordinates.longitude }}?q={{ venueRel.place.coordinates.latitude }},{{ venueRel.place.coordinates.longitude }}({{ (venueRel["target-credit"] || venueRel.place.name) |> encodeURIComponent }})'
                      class="menu__item"
                      role="menuitem"
                    >
                      {{
                        comp.base.Icon({
                          name: "navigation",
                          catalog: "lucide",
                          classes: "w-4 h-4",
                        })
                      }}
                      <span class="typography-sublabel">Native App</span>
                    </a>

                    <a
                      href="https://www.openstreetmap.org/?mlat={{ venueRel.place.coordinates.latitude }}&mlon={{ venueRel.place.coordinates.longitude }}"
                      target="_blank"
                      class="menu__item"
                      role="menuitem"
                    >
                      {{
                        comp.base.Icon({
                          name: "map",
                          catalog: "lucide",
                          classes: "w-4 h-4",
                        })
                      }}
                      <span class="typography-sublabel">OpenStreetMap</span>
                    </a>

                    <a
                      href="https://maps.google.com/maps?q={{ venueRel.place.coordinates.latitude }},{{ venueRel.place.coordinates.longitude }}"
                      target="_blank"
                      class="menu__item"
                      role="menuitem"
                    >
                      {{
                        comp.base.Icon({
                          name: "map-pin",
                          catalog: "lucide",
                          classes: "w-4 h-4",
                        })
                      }}
                      <span class="typography-sublabel">Google Maps</span>
                    </a>
                  </div>

                  <button
                    type="button"
                    class="event-page__map-trigger"
                    aria-label="Get directions to {{ event.venueName }}"
                    aria-haspopup="true"
                  >
                    {{
                      comp.base.Icon({
                        name: "compass",
                        catalog: "lucide",
                        classes: "w-4 h-4",
                      })
                    }}
                    <span class="typography-sublabel"
                    >Directions</span>
                  </button>
                </div>
              </div>
            {{ /if }}
          </div>
        {{ else }}
          <p class="event-page__tba">Venue TBA</p>
        {{ /if }}
      </section>

      <div class="event-page__actions">
        {{
          set urlRels = (event.relations || []).filter((r) =>
            r["target-type"] === "url" &&
            !r.url.resource.includes("instagram.com")
          )
        }}

        <div class="event-page__actions-links">
          {{ if event.local?.tickets_url }}
            <a
              href="{{ event.local.tickets_url }}"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-minimal"
            >
              {{
                comp.base.Icon({
                  name: "ticket",
                  catalog: "lucide",
                  classes: "w-4 h-4",
                })
              }}
              Tickets
            </a>
          {{ /if }}

          {{ if event.local?.instagram_url }}
            {{>
              const igUrls = Array.isArray(event.local.instagram_url)
              ? event.local.instagram_url
              : [event.local.instagram_url]
            }}
            {{ for index, url of igUrls }}
              <a
                href="{{ url }}"
                target="_blank"
                rel="noopener noreferrer"
                class="btn-minimal"
              >
                {{
                  comp.base.Icon({
                    name: "instagram",
                    catalog: "simpleicons",
                    classes: "w-4 h-4",
                  })
                }}
                {{ if igUrls.length > 1 }}
                  Instagram Post #{{ index + 1 }}
                {{ else }}
                  Instagram Post
                {{ /if }}
              </a>
            {{ /for }}
          {{ /if }}

          {{ for rel of urlRels }}
            {{ set info = rel.type |> getLinkInfo(rel.url.resource) }}
            <a
              href="{{ rel.url.resource }}"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-minimal"
            >
              {{
                comp.base.Icon({
                  name: info.icon,
                  catalog: info.catalog,
                  classes: "w-4 h-4",
                })
              }}
              {{ info.label }}
            </a>
          {{ /for }}
        </div>
      </div>
    </aside>
  </div>

  {{ if gallery && gallery.length > 0 }}
    <section class="event-page__gallery">
      {{ comp.ui.SectionHeader({ title: "Photographs" }) }}
      {{ await comp.ui.Gallery({ images: gallery }) }}
    </section>
  {{ /if }}
</div>
