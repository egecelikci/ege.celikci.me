{
  "prefetch": [
    {
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/api/*" } },
          { "not": { "href_matches": "/collage/*" } },
          { "not": { "href_matches": "/*.(atom|json|xml|ics|pmtiles)" } },
          { "not": { "selector_matches": "[rel~=nofollow], [download]" } }
        ]
      },
      "eagerness": "moderate"
    }
  ]
}
