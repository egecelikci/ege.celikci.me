---
title: topics
searchable: false
noindex: true
prose: false
menu:
  group: entries
  title: topics
  label: tags
  order: 3
  children:
    - title: recipes
      href: /tags/recipes/
      desc: treats
navigation:
  parent: /
---

{{# --- 1. TAG CLOUD (Clean Typographic Style) --- #}}
{{ set tagsContent }}
  {{ set allTags = search.values("tags") }}

  <ul class="h-feed tag-cloud">
    {{ if allTags.length > 0 }}
      {{ for tag of allTags }}
        {{# Get count for this tag #}}
        {{ set tagCount = search.pages("'" + tag + "'").length }}
        {{ set tagSlug = tag |> slugify }}

        <li class="tag-cloud__item">
          {{
            comp.base.Tag({
              content: tag,
              href: "/tags/" + tagSlug + "/",
            })
          }}
          <span class="tag-cloud__count">{{ tagCount }}</span>
        </li>
      {{ /for }}
    {{ else }}
      <div class="tag-cloud__empty">
        {{
          comp.base.EmptyState({
            icon: "tag",
            title: "no topics found",
            description: "tags will appear here once you add them to your posts or notes",
          })
        }}
      </div>
    {{ /if }}
  </ul>
{{ /set }}

{{ tagsContent |> safe }}
