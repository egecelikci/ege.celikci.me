---
title: notes
description: "ephemeral updates, logs & short form of content"
prose: false
searchable: false
noindex: true
menu:
  group: entries
  label: posts
  order: 2
navigation:
  parent: /
---

{{ set notes = search.pages("type=note", "date=desc") }}

{{> monthNames = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"] }}
{{
  set byMonth = Object.groupBy(notes, (n) =>
    `${n.date.getFullYear()}-${String(n.date.getMonth() + 1).padStart(2, "0")}`)
}}
{{ set monthKeys = Object.keys(byMonth) }}
{{ set years = [...new Set(monthKeys.map((k) => k.slice(0, 4)))] }}
{{ set railItems = [] }}
{{ for year of years }}
  {{
    set railItems = railItems.concat([{
      target: `year-${year}`,
      text: year,
      variant: "primary",
      year: year,
      ariaLabel: `notes from ${year}`,
    }])
  }}
  {{ set yKeys = monthKeys.filter((k) => k.startsWith(`${year}-`)) }}
  {{ for mk of yKeys }}
    {{
      set railItems = railItems.concat([{
        target: mk,
        text: monthNames[Number(mk.slice(5)) - 1],
        variant: "sub",
        year: year,
        ariaLabel: `notes from ${monthNames[Number(mk.slice(5)) - 1]} ${year}`,
      }])
    }}
  {{ /for }}
{{ /for }}

{{ if notes.length }}
  {{ await comp.ui.Rail({ label: "jump to month", items: railItems }) }}

  <div class="h-feed notes-index">
    {{ for year of years }}
      <section
        class="notes-year"
        id="year-{{ year }}"
        data-year="{{ year }}"
      >
        {{
          await comp.ui.SectionHeader({
            title: year,
            variant: "large",
          })
        }}
        {{ set yKeys = monthKeys.filter((k) => k.startsWith(`${year}-`)) }}
        {{ for mk of yKeys }}
          <section
            class="notes-month"
            id="{{ mk }}"
            data-year="{{ year }}"
          >
            {{
              await comp.ui.SectionHeader({
                title: `${monthNames[Number(mk.slice(5)) - 1]} ${year}`,
                variant: "label",
                level: 3,
              })
            }}
            {{ for item of byMonth[mk] }}
              {{
                await comp.ui.EntryRow({
                  entry: item,
                  showDate: true,
                  hideLabel: true,
                  hideYear: true,
                })
              }}
            {{ /for }}
          </section>
        {{ /for }}
      </section>
    {{ /for }}
  </div>
{{ else }}
  <div class="notes-index__empty">
    {{
      comp.base.EmptyState({
        icon: "message-square",
        title: "no notes found",
        description: "once you publish a note, it will appear on this timeline",
      })
    }}
  </div>
{{ /if }}
