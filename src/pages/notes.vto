---
title: notes
description: "ephemeral updates, logs & short form of content"
prose: false
searchable: false
noindex: true
menu:
  group: entries
  label: posts
  order: 2
navigation:
  parent: /
---

{{ set notes = search.pages("type=note", "date=desc") }}

{{> monthNames = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"] }}
{{
  set byMonth = Object.groupBy(notes, (n) =>
    `${n.date.getFullYear()}-${String(n.date.getMonth() + 1).padStart(2, "0")}`)
}}
{{ set monthKeys = Object.keys(byMonth) }}
{{ set years = [...new Set(monthKeys.map((k) => k.slice(0, 4)))] }}

{{ if notes.length }}
  <div class="rail-layout">
  <nav class="rail" aria-label="jump to month">
      {{ for year of years }}
        {{ set yKeys = monthKeys.filter((k) => k.startsWith(`${year}-`)) }}
        <a
          href="#{{ yKeys[0] }}"
          class="rail__link rail__link--primary"
          data-target="{{ yKeys[0] }}"
          data-year="{{ year }}"
          aria-label="notes from {{ year }}"
        >{{ year }}</a>
        {{ for mk of yKeys }}
          <a
            href="#{{ mk }}"
            class="rail__link rail__link--sub"
            data-target="{{ mk }}"
            data-year="{{ year }}"
            aria-label="notes from {{ monthNames[Number(mk.slice(5)) - 1] }} {{ year }}"
          >{{ monthNames[Number(mk.slice(5)) - 1] }}</a>
        {{ /for }}
      {{ /for }}
    </nav>

  <div class="rail-layout__main">
    <div class="h-feed notes-index">
    {{ for mk of monthKeys }}
      <section
        class="notes-month"
        id="{{ mk }}"
        data-year="{{ mk.slice(0, 4) }}"
      >
        {{
          await comp.ui.SectionHeader({
            title: `${monthNames[Number(mk.slice(5)) - 1]} ${mk.slice(0, 4)}`,
            variant: "label",
          })
        }}
        {{ for item of byMonth[mk] }}
          {{
            await comp.ui.EntryRow({
              entry: item,
              showDate: true,
              hideLabel: true,
            })
          }}
        {{ /for }}
      </section>
    {{ /for }}
      </div>
  </div>
</div>
{{ else }}
  <div class="notes-index__empty">
    {{
      comp.base.EmptyState({
        icon: "message-square",
        title: "no notes found",
        description: "once you publish a note, it will appear on this timeline",
      })
    }}
  </div>
{{ /if }}
