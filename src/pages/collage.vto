---
title: collage
description: "generate album collages from ListenBrainz or Last.fm"
prose: false
menu:
  group: tools
  label: "for 9:16 stories"
  order: 1
---

<div
  class="collage-tool"
  data-collage-tool
  data-default-username="{{ author.username }}"
>
  <div class="collage-tool__layout">
    <div class="collage-tool__controls">
      <div class="collage-tool__panel">
        <div class="collage-tool__blob collage-tool__blob--primary"></div>
        <div class="collage-tool__blob collage-tool__blob--secondary"></div>
        <div class="collage-tool__section">
          <div class="collage-tool__field">
            <label for="service-select" class="collage-tool__label">Service</label>
            <div class="collage-tool__source-grid">
              <button
                id="source-lb"
                class="collage-tool__source"
                aria-label="Use ListenBrainz"
              >
                {{ comp.base.Icon({ name: "brain-circuit" }) }}
                <span>ListenBrainz</span>
              </button>
              <button
                id="source-lfm"
                class="collage-tool__source"
                aria-label="Use Last.fm"
              >
                {{ comp.base.Icon({ name: "music" }) }}
                <span>Last.fm</span>
              </button>
            </div>
          </div>
          <div class="collage-tool__field">
            <label for="username" class="collage-tool__label">Username</label>
            <div class="collage-tool__input-wrap collage-tool__input-wrap--icon">
              <input
                type="text"
                id="username"
                placeholder="Enter your username"
                class="input-base input-focus collage-tool__input"
                value="{{ author.username }}"
                aria-describedby="username-hint"
              />
              {{
                comp.base.Icon({
                  name: "at-sign",
                  classes:
                    "collage-tool__input-icon",
                })
              }}
            </div>
            <p id="username-hint" class="collage-tool__hint">
              Your username on the selected service
            </p>
          </div>
        </div>

        <div class="collage-tool__divider"></div>
        <div class="collage-tool__section">
          <details class="collage-tool__details" open>
            <summary class="collage-tool__summary">
              <span>Appearance</span>
              {{
                comp.base.Icon({
                  name: "chevron-down",
                  classes: "collage-tool__chevron",
                })
              }}
            </summary>

            <div class="collage-tool__section">
              <div class="collage-tool__field">
                <div class="collage-tool__field">
                  <label for="period" class="collage-tool__label"
                  >Time Period</label>
                  <div class="collage-tool__select-wrap">
                    <select
                      id="period"
                      class="input-base input-focus collage-tool__select"
                      aria-label="Select time period"
                    >
                    </select>
                    {{
                      comp.base.Icon({
                        name: "chevron-down",
                        classes: "collage-tool__select-icon",
                      })
                    }}
                  </div>
                </div>
                <div class="collage-tool__field">
                  <label for="bg-mode" class="collage-tool__label"
                  >Style</label>
                  <div class="collage-tool__select-wrap">
                    <select
                      id="bg-mode"
                      class="input-base input-focus collage-tool__select"
                      aria-label="Select visual style"
                    >
                      <option value="aura" selected>Aura</option>
                      <option value="silver">Silver</option>
                      <option value="velvet">Velvet</option>
                      <option value="terminal">Terminal</option>
                      <option value="thermal">Thermal</option>
                      <option value="dark">Dark</option>
                    </select>
                    {{
                      comp.base.Icon({
                        name: "sparkles",
                        classes: "collage-tool__select-icon",
                      })
                    }}
                  </div>
                </div>
                <div class="collage-tool__field">
                  <label for="grid-size" class="collage-tool__label"
                  >Grid Layout</label>
                  <div class="collage-tool__select-wrap">
                    <select
                      id="grid-size"
                      class="input-base input-focus collage-tool__select"
                      aria-label="Select grid size"
                    >
                      <option value="3x3" selected>3×3</option>
                      <option value="4x4">4×4</option>
                      <option value="5x5">5×5</option>
                    </select>
                    {{
                      comp.base.Icon({
                        name: "grid-3x3",
                        classes: "collage-tool__select-icon",
                      })
                    }}
                  </div>
                </div>
                <div class="collage-tool__field">
                  <label for="text-case" class="collage-tool__label"
                  >Text Style</label>
                  <div class="collage-tool__select-wrap">
                    <select
                      id="text-case"
                      class="input-base input-focus collage-tool__select"
                      aria-label="Select text casing"
                    >
                      <option value="none" selected>Original</option>
                      <option value="upper">UPPERCASE</option>
                      <option value="lower">lowercase</option>
                    </select>
                    {{
                      comp.base.Icon({
                        name: "type",
                        classes: "collage-tool__select-icon",
                      })
                    }}
                  </div>
                </div>
              </div>
              <div class="collage-tool__field">
                <div class="collage-tool__field-row">
                  <span class="collage-tool__label">Effects</span>
                </div>
                <div class="collage-tool__toggle-grid">
                  <label class="collage-tool__toggle">
                    <input
                      type="checkbox"
                      id="grain"
                      checked
                      class="checkbox-base"
                      aria-label="Enable film grain effect"
                    >
                    <div class="collage-tool__toggle-text">
                      <span class="collage-tool__toggle-title">Grain</span>
                      <span class="collage-tool__toggle-desc">Film texture</span>
                    </div>
                  </label>
                  <label class="collage-tool__toggle">
                    <input
                      type="checkbox"
                      id="glass"
                      class="checkbox-base"
                      aria-label="Enable glass effect"
                    >
                    <div class="collage-tool__toggle-text">
                      <span class="collage-tool__toggle-title">Glass</span>
                      <span class="collage-tool__toggle-desc"
                      >Frosted overlay</span>
                    </div>
                  </label>
                </div>
                <label class="collage-tool__toggle">
                  <input
                    type="checkbox"
                    id="darken-bottom"
                    class="checkbox-base"
                    aria-label="Darken bottom section"
                  >
                  <div class="collage-tool__toggle-text">
                    <span class="collage-tool__toggle-title">Dim Bottom</span>
                    <span class="collage-tool__toggle-desc"
                    >Darker album list area</span>
                  </div>
                </label>
              </div>
            </div>
          </details>
        </div>

        <div class="collage-tool__divider"></div>
        <div class="collage-tool__section">
          <details class="collage-tool__details" open>
            <summary class="collage-tool__summary">
              <span>Content Options</span>
              {{
                comp.base.Icon({
                  name: "chevron-down",
                  classes: "collage-tool__chevron",
                })
              }}
            </summary>

            <div class="collage-tool__section">
              <label class="collage-tool__toggle collage-tool__toggle--row">
                <div class="collage-tool__toggle-body">
                  {{
                    comp.base.Icon({
                      name: "image-off",
                      classes: "collage-tool__toggle-icon",
                    })
                  }}
                  <div class="collage-tool__toggle-text">
                    <span class="collage-tool__toggle-title"
                    >Skip missing cover art</span>
                    <span class="collage-tool__toggle-desc"
                    >Hide albums without covers</span>
                  </div>
                </div>
                <input
                  type="checkbox"
                  id="skip-missing"
                  checked
                  class="checkbox-base"
                  aria-label="Skip albums without cover art"
                >
              </label>

              <label class="collage-tool__toggle collage-tool__toggle--row">
                <div class="collage-tool__toggle-body">
                  {{
                    comp.base.Icon({
                      name: "hash",
                      classes: "collage-tool__toggle-icon",
                    })
                  }}
                  <div class="collage-tool__toggle-text">
                    <span class="collage-tool__toggle-title"
                    >Display listen counts</span>
                  </div>
                </div>
                <input
                  type="checkbox"
                  id="show-counts"
                  class="checkbox-base"
                  aria-label="Show play counts"
                >
              </label>

              <label class="collage-tool__toggle collage-tool__toggle--row">
                <div class="collage-tool__toggle-body">
                  {{
                    comp.base.Icon({
                      name: "globe",
                      classes: "collage-tool__toggle-icon",
                    })
                  }}
                  <div class="collage-tool__toggle-text">
                    <span class="collage-tool__toggle-title"
                    >Show website name</span>
                  </div>
                </div>
                <input
                  type="checkbox"
                  id="show-site"
                  checked
                  class="checkbox-base"
                  aria-label="Show site name in footer"
                >
              </label>
            </div>
          </details>
        </div>
        <div class="collage-tool__divider"></div>
        <div class="collage-tool__section">
          <details class="collage-tool__details">
            <summary class="collage-tool__summary">
              <span>Advanced Options</span>
              {{
                comp.base.Icon({
                  name: "chevron-down",
                  classes: "collage-tool__chevron",
                })
              }}
            </summary>

            <div class="collage-tool__section">
              <div class="collage-tool__field">
                <label for="font-family" class="collage-tool__label"
                >Custom Font</label>
                <div class="collage-tool__input-wrap">
                  <input
                    type="text"
                    id="font-family"
                    placeholder="DM Sans"
                    class="input-base input-focus collage-tool__input"
                    aria-describedby="font-hint"
                  />
                </div>
                {{
                  set calloutText = "Enter a font name from [Google Fonts](https://fonts.google.com/)"
                  |> md
                }}

                {{
                  comp.base.Callout({
                    variant: "action",
                    icon: "badge-info",
                    content: calloutText,
                  })
                }}
              </div>
              <div class="collage-tool__field">
                <div class="collage-tool__field-row">
                  <label for="footer-text" class="collage-tool__label"
                  >Footer Text</label>
                  <label class="collage-tool__auto-toggle">
                    <input
                      type="checkbox"
                      id="footer-auto"
                      checked
                      class="checkbox-base collage-tool__checkbox-sm"
                      aria-label="Use automatic footer text"
                    >
                    <span class="collage-tool__auto-label"
                    >Auto-generate</span>
                  </label>
                </div>
                <input
                  type="text"
                  id="footer-text"
                  placeholder="Custom footer text"
                  class="input-base input-focus collage-tool__input"
                  disabled
                  aria-describedby="footer-hint"
                />
                <p id="footer-hint" class="collage-tool__hint">
                  Leave empty to use automatic text based on period
                </p>
              </div>
              <div class="collage-tool__field">
                <label for="aliases" class="collage-tool__label"
                >Artist Aliases</label>
                <textarea
                  id="aliases"
                  placeholder="Ye -> Kanye West"
                  rows="3"
                  class="input-base input-focus collage-tool__input collage-tool__textarea"
                  aria-describedby="aliases-hint"
                ></textarea>
                <p id="aliases-hint" class="collage-tool__hint">
                  Merge artists with different names (one per line)
                </p>
              </div>
            </div>
          </details>
        </div>
      </div>
    </div>
    <div
      id="preview-wrapper"
      class="collage-tool__preview"
    >
      <div class="collage-tool__frame">
        <canvas
          id="collage-canvas"
          width="1080"
          height="1920"
          class="collage-tool__canvas"
          aria-label="Generated album collage preview"
        ></canvas>
        <div class="collage-tool__overlay">
          <div class="collage-tool__dimensions">
            {{ comp.base.Icon({ name: "maximize", classes: "" }) }}
            <span class="collage-tool__dimension-text">1080 × 1920</span>
          </div>
        </div>
        <div
          id="canvas-loader"
          class="collage-tool__loader"
        >
          <div class="collage-tool__loader-inner">
            <div class="collage-tool__spinner"></div>
            <div class="collage-tool__status-wrap">
              <span
                id="status-text"
                class="collage-tool__status"
              >initializing…</span>
            </div>
          </div>
        </div>
        <div
          id="empty-state"
          class="collage-tool__empty"
        >
          <div class="collage-tool__empty-inner">
            <div class="collage-tool__empty-icon">
              {{ comp.base.Icon({ name: "image", classes: "" }) }}
            </div>
            <div>
              <h3 class="collage-tool__empty-title">Ready to Create</h3>
              <p class="collage-tool__empty-desc">
                Enter your username to generate your collage
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="collage-tool__actions">
        <div id="result-actions" class="collage-tool__action-grid">
          <button
            id="download-btn"
            class="btn-minimal collage-tool__btn"
            aria-label="Download collage as JPG"
            disabled
          >
            {{
              comp.base.Icon({
                name: "download",
                classes: "",
              })
            }}
            <span class="typography-label">Download</span>
          </button>
          <button
            id="share-btn"
            class="btn-minimal collage-tool__btn"
            aria-label="Share collage"
            disabled
          >
            {{
              comp.base.Icon({
                name: "share-2",
                classes: "",
              })
            }}
            <span class="typography-label">Share</span>
          </button>
        </div>

        <div class="collage-tool__action-hint">
          {{ comp.base.Icon({ name: "info", classes: "" }) }}
          <span>Changes auto-save and regenerate your collage</span>
        </div>
      </div>
    </div>
  </div>
</div>
