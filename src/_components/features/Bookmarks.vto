{{#
  Component: Bookmarks (Feature)
  A refined, data-driven directory of digital connections.

  Props:
    - filteredBookmarks: Bookmark[]
    - allCategoryIds: string[]
    - categoryMetadata: CategoryMetadata[]  — enriched with .count at build time
    - totalCount: number
    - activeCategory: string | null
#}}

<div
  class="bookmarks-page flow"
  data-pagefind-filter="type:bookmark"
>
  {{# ── Filter Strip ────────────────────────────────────────────────────── #}}
  {{#
    Wrapping monospace index — no scroll, no shadows.
    Breaks naturally across lines on narrow viewports.
  #}}
  <nav
    class="bookmark-filter-nav"
    aria-label="Filter bookmarks by category"
  >
    <a
      id="group-all"
      href="/bookmarks/"
      class="bookmark-index-link {{ if !it.activeCategory }}bookmark-index-link--active{{ /if }}"
    >
      all<span class="bookmark-index-count">{{ it.totalCount ?? it.filteredBookmarks.length }}</span>
    </a>

    {{ for catId of it.allCategoryIds }}
      {{> const meta = it.categoryMetadata.find((m) => m.id === catId) }}
      <a
        id="group-{{ catId }}"
        href="/bookmarks/{{ catId }}/"
        class="bookmark-index-link {{ if it.activeCategory == catId }}bookmark-index-link--active{{ /if }}"
      >
        {{ meta?.title || catId }}<span class="bookmark-index-count">{{ meta?.count ?? 0 }}</span>
      </a>
    {{ /for }}
  </nav>

  {{# ── Unified Search (Under Nav) ───────────────────────────────────────── #}}
  {{ if it.search_bar && it.activeCategory !== "88x31" }}
    <div class="bookmark-filter-search">
      {{
        await it.comp.features.Search({
          compId: "bookmark-filter",
          ...it.search_bar,
        })
      }}
    </div>
  {{ /if }}

  {{# ── 88×31 Grid View ─────────────────────────────────────────────────── #}}
  {{ if it.activeCategory == "88x31" }}
    <section>
      <div class="bookmark-badge-grid">
        {{ for item of it.filteredBookmarks |> shuffle }}
          <a
            id="bm-{{ item.title |> slugify }}"
            href="{{ item.url || "#" }}"
            target="_blank"
            rel="noopener noreferrer"
            class="bookmark-badge"
            title="{{ item.title }}"
          >
            <div class="bookmark-badge__frame">
              <img
                src="{{ item.img |> url }}"
                alt="{{ item.title |> escape }}"
                width="88"
                height="31"
                loading="lazy"
              />
            </div>
            <span class="bookmark-badge__title">
              {{ item.title }}
            </span>
          </a>
        {{ /for }}
      </div>
    </section>

    {{# ── Main Bookmark List ──────────────────────────────────────────────── #}}
  {{ else }}
    <div class="bookmark-list">
      {{ for item of it.filteredBookmarks }}
        {{# Only show in the list if it has substance (url, desc, feed, or mirrors) #}}
        {{
          if !item.url && !item.desc && !item.feed && !item.mirrors?.length
        }}{{ continue }}{{ /if }}
        <article
          id="bm-{{ item.title |> slugify }}"
          class="{{ if item.categories.includes('person') }}h-card{{ else }}h-entry{{ /if }} bookmark-card"
          data-search-item
          data-search-data="{{ [item.title, item.url, item.desc, item.categories?.join(' ')] |> filter(Boolean) |> join(' ') }}"
        >
          {{# ── Badge column — snapped to top right ── #}}
          {{ if item.img }}
            <div class="bookmark-card__badge">
              <a
                href="{{ item.url || "#" }}"
                target="_blank"
                rel="noopener noreferrer"
                class="bookmark-card__badge-link"
                tabindex="-1"
                aria-hidden="true"
              >
                <img
                  src="{{ item.img |> url }}"
                  alt=""
                  width="88"
                  height="31"
                  loading="lazy"
                />
              </a>
            </div>
          {{ /if }}

          {{# ── Text column ── #}}
          <div
            class="bookmark-card__body {{ if item.img }}bookmark-card__body--has-image{{ /if }}"
          >
            {{# Title #}}
            <a
              href="{{ item.url || "#" }}"
              target="_blank"
              rel="noopener noreferrer {{ if item.categories.includes('person') }}u-url{{ else }}u-bookmark-of h-cite{{ /if }}"
            >
              <span
                class="{{ if item.categories.includes('person') }}p-name{{ /if }} bookmark-card__title"
              >
                {{ item.title }}
              </span>
            </a>

            {{# URLs (Origin + Mirrors) #}}
            <div class="bookmark-card__urls">
              {{ if item.url }}
                <a
                  href="{{ item.url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bookmark-card__url"
                >
                  {{
                    await it.comp.base.Icon({
                      name: "link",
                      catalog: "lucide",
                      classes: "w-3 h-3",
                    })
                  }}
                  <span>
                    {{
                      item.url
                      |> replace("https://", "")
                      |> replace("http://", "")
                      |> replace(/\/$/, "")
                    }}
                  </span>
                </a>
              {{ /if }}

              {{ if item.mirrors?.length }}
                {{ for mirror of item.mirrors }}
                  <a
                    href="{{ mirror }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bookmark-card__url"
                    title="Mirror: {{ mirror |> replace('https://', '') |> replace('http://', '') |> replace(/\/.*$/, '') }}"
                  >
                    {{
                      await it.comp.base.Icon({
                        name: "globe",
                        catalog: "lucide",
                        classes: "w-3 h-3",
                      })
                    }}
                    <span>
                      {{
                        mirror
                        |> replace("https://", "")
                        |> replace("http://", "")
                        |> replace(/\/.*$/, "")
                      }}
                    </span>
                  </a>
                {{ /for }}
              {{ /if }}
            </div>

            {{# Description — full text, no clamping #}}
            {{ if item.desc }}
              <div
                class="{{ if item.categories.includes('person') }}p-note{{ /if }} bookmark-card__desc markdown markdown-inline"
              >
                {{ item.desc |> md |> safe }}
              </div>
            {{ /if }}

            {{# Category tags — omit 88x31, blogroll, and the current filter #}}
            {{>
              const visibleCats = item.categories.filter((c) =>
                c !== "88x31" && c !== "blogroll" && c !== it.activeCategory
              )
            }}
            {{ if visibleCats.length > 0 }}
              <div class="bookmark-card__tags">
                {{ for catId of visibleCats }}
                  {{>
                    const meta = it.categoryMetadata.find((m) => m.id === catId)
                  }}
                  <a
                    href="/bookmarks/{{ catId }}/"
                    class="bookmark-card__tag"
                  >
                    {{ if meta?.icon }}
                      {{
                        await it.comp.base.Icon({
                          name: meta.icon,
                          catalog: "lucide",
                          classes: "w-3 h-3",
                        })
                      }}
                    {{ else }}
                      {{
                        await it.comp.base.Icon({
                          name: "hash",
                          catalog: "lucide",
                          classes: "w-3 h-3",
                        })
                      }}
                    {{ /if }}
                    {{ meta?.title || catId }}
                  </a>
                {{ /for }}
              </div>
            {{ /if }}

            {{# RSS Feed Row #}}
            {{ if item.feed }}
              <div>
                <a
                  href="{{ item.feed }}"
                  class="bookmark-card__feed"
                  title="Subscribe via RSS / Atom"
                >
                  {{
                    await it.comp.base.Icon({
                      name: "rss",
                      catalog: "lucide",
                      classes: "w-3 h-3",
                    })
                  }}
                  <span>
                    feed
                  </span>
                </a>
              </div>
            {{ /if }}
          </div>

          {{# ── Mobile Badge — flows naturally at the end ── #}}
          {{ if item.img }}
            <div class="bookmark-card__badge-mobile">
              <a
                href="{{ item.url || "#" }}"
                target="_blank"
                rel="noopener noreferrer"
                class="bookmark-card__badge-link"
                tabindex="-1"
                aria-hidden="true"
              >
                <img
                  src="{{ item.img |> url }}"
                  alt=""
                  width="88"
                  height="31"
                  loading="lazy"
                />
              </a>
            </div>
          {{ /if }}
        </article>
      {{ /for }}
    </div>
  {{ /if }}

  {{# ── Empty State ─────────────────────────────────────────────────────── #}}
  {{ if it.filteredBookmarks.length == 0 }}
    <div class="bookmark-empty">
      {{
        await it.comp.base.EmptyState({
          icon: "bookmark-x",
          title: "nothing in this category yet",
          description:
            `try checking <a href="/bookmarks/" class="link-underline">all bookmarks</a>`,
        })
      }}
    </div>
  {{ /if }}
</div>
