<div class="brew-calculator not-prose">
  <label class="brew-calculator__field">
    <span class="brew-calculator__label">Target Volume (ml)</span>
    <input
      type="number"
      id="coffee-input"
      value="500"
      step="50"
      class="input-base input-focus brew-calculator__input"
    >
  </label>

  <div class="brew-calculator__list">
    <div class="brew-calculator__row">
      <span class="brew-calculator__row-label">Coffee</span>
      <span
        class="brew-calculator__row-value"><span id="out-coffee">32.5</span>g</span>
    </div>
    <div class="brew-calculator__row">
      <span class="brew-calculator__row-label">Ice (40%)</span>
      <span
        class="brew-calculator__row-value"><span id="out-ice">200</span>g</span>
    </div>
    <div class="brew-calculator__row">
      <span class="brew-calculator__row-label">Hot Water (60%)</span>
      <span
        class="brew-calculator__row-value"><span id="out-hot">300</span>g</span>
    </div>
    <div class="brew-calculator__row brew-calculator__row--bloom">
      <span class="brew-calculator__row-label">Bloom Water</span>
      <span
        class="brew-calculator__row-value"><span id="out-bloom">97</span>g</span>
    </div>
  </div>
</div>
