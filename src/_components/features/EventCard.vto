{{ set detailUrl = `/event/${it.event.id}/` }}
{{ set isPast = !it.event.isUpcoming }}
{{
  set posterUrl = it.event.imagePath || it.event.posterThumb || it.event.posterUrl
}}
{{ set posterMonoUrl = it.event.imagePathMono }}
{{ set isCustomTitle = it.event.isCustomTitle ?? false }}
{{ set displayTitle = it.event.displayTitle || it.event.name || "Event" }}
{{
  set artistNames = it.event.relations
  ?.filter((r) => r["target-type"] === "artist")
  ?.map((r) => r["target-credit"] || r.artist.name)
  ?.join(" ") || ""
}}
{{ set cardClass = "event-card ledger-card" }}
{{ if isPast }}
  {{ set cardClass = cardClass + " event-card--past" }}
{{ else }}
  {{ set cardClass = cardClass + " event-card--upcoming" }}
{{ /if }}
{{ if isCustomTitle }}{{ set cardClass = cardClass + " event-card--custom-title" }}{{ /if }}

<a
  href="{{ detailUrl }}"
  id="ev-{{ it.event.id }}"
  data-search-item
  data-search-data="{{ [displayTitle, artistNames, it.event.type] |> filter(Boolean) |> join(' ') }}"
  class="{{ cardClass }}"
>
  <div class="event-card__poster">
    {{ if posterUrl }}
      <img
        src="{{ if isPast && posterMonoUrl }}{{ posterMonoUrl }}{{ else }}{{ posterUrl }}{{ /if }}"
        alt="{{ displayTitle |> escape }}"
        class="event-card__poster-image"
        loading="lazy"
      />
      {{ if !isPast && posterMonoUrl }}
        <img
          src="{{ posterMonoUrl }}"
          alt="{{ displayTitle |> escape }} (monochrome)"
          class="event-card__poster-image event-card__poster-image--mono"
          loading="lazy"
        />
      {{ /if }}
    {{ else }}
      <div class="event-card__poster-fallback">
        {{ await it.comp.base.Icon({ name: "image", catalog: "lucide" }) }}
        <span>No Poster</span>
      </div>
    {{ /if }}
  </div>

  <div class="event-card__content">
    <div class="event-card__stack">
      <div class="event-card__date-row">
        <time class="event-card__date">
          {{ if it.event.beginDate }}
            {{ it.event.beginDate |> date("EEE, MMM dd") }}
          {{ else }}
            TBA
          {{ /if }}
        </time>

        {{ if it.event.time }}
          <div class="event-card__dot"></div>
          <span class="event-card__time">{{ it.event.time }}</span>
        {{ /if }}
      </div>

      <div class="event-card__headline">
        {{ if isCustomTitle }}
          <h3 class="event-card__title">{{ it.event.name }}</h3>
        {{ /if }}

        {{ if it.event.relations?.length > 0 }}
          <div class="event-card__lineup">
            {{
              set artistRels = it.event.relations.filter((r) =>
                r["target-type"] === "artist" &&
                !["illustration", "graphic design", "artwork", "design", "engineer"].includes(
                  r.type,
                )
              )
            }}
            {{ for index, rel of artistRels -}}
              <span>{{ rel["target-credit"] || rel.artist.name }}</span>
              {{- if index < artistRels.length - 2 }},
              {{ else if index === artistRels.length - 2 }}
                &
              {{ /if -}}
            {{ /for }}
          </div>
        {{ /if }}
      </div>
    </div>

    {{
      await it.comp.ui.ListingFooter({
        compact: true,
        leftText: it.event.type || "event",
        text: "details",
      })
    }}
  </div>
</a>
