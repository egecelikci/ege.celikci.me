{{#
  Component: Feeds (Feature)
  Data-driven feeds listing.

  Props:
    - primary_feeds: Array of feed objects
    - filtered_feeds: Array of category objects { title, desc, feeds }
    - search: Lume search object (passed from global data)
#}}

<div class="feeds">
  {{# 1. PRIMARY FEED (Site-wide) #}}
  <section class="feeds__section">
    {{
      await it.comp.ui.SectionHeader({
        title: it.primary_label,
        level: 2,
      })
    }}
    <div class="feeds__list">
      <div class="feeds__row">
        <span class="feeds__row-desc">{{ it.primary_desc }}</span>
        <div class="feeds__actions">
          {{ for feed of it.primary_feeds }}
            <a
              href="{{ it.site.url }}{{ feed.url }}"
              class="feeds__link"
              target="_blank"
            >
              {{ feed.title.split(" ")[0].toLowerCase() }}
              {{
                await it.comp.base.Icon({
                  name: "external-link",
                  classes: "w-3 h-3",
                })
              }}
            </a>
          {{ /for }}
        </div>
      </div>
    </div>
  </section>

  {{# 2. CATEGORY FEEDS #}}
  <section class="feeds__section">
    {{
      await it.comp.ui.SectionHeader({
        title: "other feeds",
        level: 2,
      })
    }}
    <div class="feeds__list">
      {{ for cat of it.filtered_feeds }}
        <div class="feeds__row">
          <div class="feeds__row-text">
            <span class="feeds__row-title">{{ cat.title }}</span>
            <span class="feeds__row-desc">{{ cat.desc }}</span>
          </div>
          <div class="feeds__actions">
            {{ for feed of cat.feeds }}
              <a
                href="{{ it.site.url }}{{ feed.url }}"
                class="feeds__link"
                target="_blank"
              >
                {{ feed.title.toLowerCase() }}
                {{
                  await it.comp.base.Icon({
                    name: "external-link",
                    classes: "w-3 h-3",
                  })
                }}
              </a>
            {{ /for }}
          </div>
        </div>
      {{ /for }}
    </div>
  </section>

  {{# 3. TOPIC FEEDS #}}
  <section class="feeds__section">
    {{
      await it.comp.ui.SectionHeader({
        title: "topic feeds",
        level: 2,
      })
    }}
    <div class="feeds__list">
      {{ set allTags = it.search.values("tags") }}
      {{ if allTags.length > 0 }}
        {{ for tag of allTags |> sort }}
          {{ set slug = tag |> slugify }}
          <div class="feeds__row">
            <div class="feeds__tags">
              {{
                await it.comp.base.Tag({
                  content: tag,
                  href: "/tags/" + slug + "/",
                })
              }}
              <span class="feeds__count">
                {{ it.search.pages("'" + tag + "'").length }} entries
              </span>
            </div>
            <div class="feeds__actions">
              <a
                href="{{ it.site.url }}/tags/{{ slug }}.atom"
                class="feeds__link"
                target="_blank"
              >
                atom
                {{
                  await it.comp.base.Icon({
                    name: "external-link",
                    classes: "w-3 h-3",
                  })
                }}
              </a>
              <a
                href="{{ it.site.url }}/tags/{{ slug }}.json"
                class="feeds__link"
                target="_blank"
              >
                json
                {{
                  await it.comp.base.Icon({
                    name: "external-link",
                    classes: "w-3 h-3",
                  })
                }}
              </a>
            </div>
          </div>
        {{ /for }}
      {{ else }}
        {{
          await it.comp.base.EmptyState({
            icon: "tag",
            title: "no topics found",
            description: "tags will appear here once you add them to your content",
          })
        }}
      {{ /if }}
    </div>
  </section>
</div>
