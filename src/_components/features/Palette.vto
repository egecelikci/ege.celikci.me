{{ for panel of it.schemes }}
<details id="{{ panel.scheme }}" class="palette-scheme"
  style="{{ panel.vars }}; background: var(--color-surface); color: var(--color-text)">
  <summary
    class="palette-scheme__title">{{ await it.comp.base.Icon({ name: "chevron-down", catalog: "lucide", classes: "palette-scheme__chevron" }) }}<h3>{{ panel.scheme }}</h3><span class="palette-scheme__preview" aria-hidden="true">{{ for token of panel.tokens }}<span class="palette-scheme__dot" style="background:{{ token.value }}"></span>{{ /for }}</span><span class="palette-scheme__count">{{ panel.count }} {{ panel.count === 1 ? "token" : "tokens" }}</span></summary>
  <ul class="palette">
{{ for row of panel.tokens }}
<li class="palette__row" style="background: {{ row.value }}; color: {{ row.text }}"><p class="palette__token">{{ row.token }}</p>{{ if row.role }}<p class="palette__desc">{{ row.role }}</p>{{ /if }}<p class="palette__value">{{ row.value }}</p></li>
{{ /for }}
  </ul>
</details>
{{ /for }}
