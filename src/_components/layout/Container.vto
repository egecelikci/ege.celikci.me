{{#
  Universal Container Component
  Props:
    - width: "narrow" | "default" | "wide" | "full" | custom class
    - as: HTML tag (default: "div")
    - centered: boolean (default: true)
    - padding: boolean | string (default: true)
    - classes: additional classes
    - attributes: object of HTML attributes (e.g. { "aria-label": "nav" })
    - content: string (body)
#}}

{{ set tag = it.as || "div" }}

{{
  set widthClass = {
    "narrow": "container--narrow",
    "default": "container--default",
    "wide": "container--wide",
    "full": "container--full",
  }[it.width] || it.width || "container--default"
}}

{{
  set paddingClass = it.padding === false
  ? ""
  : (typeof it.padding === "string" ? it.padding : "")
}}

{{
  set containerClasses = [
    "container",
    paddingClass,
    widthClass,
    it.classes,
  ]
  |> join(" ")
  |> trim
}}

<{{ tag }}
class="{{ containerClasses }}"
{{ if it.attributes }}{{ it.attributes |> attr |> safe }}{{ /if }}
>
{{ it.content |> safe }}
</{{ tag }}>
