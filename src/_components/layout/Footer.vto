{{ set footerContent }}
  <div class="site-footer__inner">
    <div class="site-footer__meta">
      <div class="site-footer__copyright">
        <span aria-label="Copyright">&copy;</span>
        {{ it.build.timestamp |> date("yyyy") }}
        <a
          href="{{ it.site.url }}"
          class="site-footer__author"
        >{{ it.author.name }}</a>
      </div>

      <span class="site-footer__sep">|</span>
      <a
        href="/colophon/"
        class="site-footer__link"
      >colophon</a>

      <span class="site-footer__sep">|</span>
      <a
        href="https://creativecommons.org/licenses/by-sa/4.0/"
        class="site-footer__link"
        rel="license"
      >
        CC BY-SA 4.0
      </a>

      {{ if it.gitInfo?.hash }}
        <span class="site-footer__sep">|</span>
        <a
          href="https://codeberg.org/{{ it.author.username }}/{{ it.site.host }}/commit/{{ it.gitInfo.hash }}"
          class="site-footer__commit"
          aria-label="view latest commit: {{ it.gitInfo.hash }}"
        >
          {{ it.gitInfo.hash.substring(0, 7) }}
        </a>
      {{ /if }}

      {{ if it.page.data.updated || it.page.data.date }}
        <span class="site-footer__sep">|</span>
        <div class="site-footer__rev">
          <span class="site-footer__rev-label">rev.</span>
          {{ it.page.data.updated || it.page.data.date |> date("dd MMM yyyy") }}
        </div>
      {{ /if }}
    </div>

    <div class="site-footer__utility">
      {{
        comp.ui.SourceLink({
          path: it.page.sourcePath,
          text: "edit",
          title: "edit this page",
        })
      }}

      <a
        href="/feeds/"
        class="site-footer__link"
      >feeds</a>

      <a
        href="#"
        class="precision-link"
        aria-label="Back to top"
      >
        <span class="reveal-slide-up">
          {{
            await it.comp.base.Icon({
              name: "arrow-up",
              classes: "w-3.5 h-3.5 stroke-[1.5]",
            })
          }}
        </span>
      </a>
    </div>
  </div>

  {{ if it.webrings && it.webrings.length > 0 }}
    <div class="site-footer__webring">
        {{ for ring of it.webrings }}
        <div class="site-footer__ring">
          <a
            href="{{ ring.prev }}"
            class="site-footer__ring-nav"
            aria-label="Previous site"
          >
            <span class="reveal-slide-left">
              {{ await it.comp.base.Icon({ name: "arrow-left", classes: "w-3 h-3" }) }}
            </span>
          </a>
          <span class="site-footer__ring-an">An</span>
          <a
            href="{{ ring.url }}"
            class="site-footer__ring-name"
          >
            {{ ring.name }}
          </a>
          <span class="site-footer__ring-emoji">{{ ring.emoji }}</span>
          <a
            href="{{ ring.next }}"
            class="site-footer__ring-nav"
            aria-label="Next site"
          >
            <span class="reveal-slide-right">
              {{ await it.comp.base.Icon({ name: "arrow-right", classes: "w-3 h-3" }) }}
            </span>
          </a>
        </div>
      {{ /for }}
    </div>
  {{ /if }}
{{ /set }}

<footer
  class="site-footer"
  role="contentinfo"
>
  {{
    await it.comp.layout.Container({
      width: "narrow",
      content: footerContent,
    })
  }}
</footer>
