{{ set extensionContent }}
  {{ if it.footerExtension }}
    {{ if it.footerExtension.comp }}
      {{ set resolvedComp = it.footerExtension.comp |> resolveComp(comp) }}
      {{ if resolvedComp }}
        {{ await resolvedComp({ ...it.footerExtension.props, ...author }) }}
      {{ /if }}
    {{ else }}
      {{ it.footerExtension |> safe }}
    {{ /if }}
  {{ /if }}
{{ /set }}

{{ set showInteractions = it.show_webmentions && it.interactions?.length > 0 }}
{{
  set showStats = it.show_webmentions && it.stats &&
  (it.stats.replies > 0 || it.stats.reposts > 0 || it.stats.likes > 0)
}}

{{
  set hasExtension = extensionContent && String(extensionContent).trim() !== ""
}}
{{ set hasRelated = it.related && String(it.related).trim() !== "" }}
{{
  set hasSyndication = it.syndication && (it.syndication.mastodon || it.syndication.bluesky || it.syndication.instagram)
}}
{{ set hasActivity = showInteractions || showStats || hasSyndication }}
{{ set hasMetaRow = hasExtension || hasActivity }}
{{ set shouldRenderFooter = hasMetaRow || hasRelated }}

{{ if shouldRenderFooter }}
  <footer
  class="page-footer"
>
    {{ if hasMetaRow }}
      <div
        class="page-footer__meta {{ if hasRelated }}page-footer__meta--divided{{ /if }}"
      >
        {{ if hasExtension }}
          <div class="page-footer__extension">
            {{ extensionContent |> safe }}
          </div>
        {{ /if }}

        {{ if hasActivity }}
          <div class="page-footer__activity-row">
            <div class="page-footer__activity-left">
              <div class="page-footer__interactions">
                {{ if showInteractions }}
                  {{ await it.comp.layout.LinkLine({
                    label: "mentions",
                    items: [
                      {
                        icon: "at-sign",
                        catalog: "lucide",
                        label: `${it.interactions.length} ${it.interactions.length == 1 ? "interaction" : "interactions"}`,
                      },
                      {
                        icon: "badge-question-mark",
                        catalog: "lucide",
                        url: "https://indieweb.org/Webmention",
                        label: "What’s this?",
                      },
                    ],
                  }) |> safe }}
                {{ /if }}
              </div>
            </div>

            <div class="page-footer__syndication">
              {{
                await it.comp.ui.ActivityMeta({
                  stats: showInteractions ? null : it.stats,
                  syndication: it.syndication,
                }) |> safe
              }}
            </div>
          </div>
          {{ if showInteractions }}
            <div id="interactions" class="page-footer__faces">
              {{ await it.comp.ui.WebmentionFaces({ mentions: it.interactions }) |> safe }}
            </div>
          {{ /if }}

          {{ if showInteractions }}
            <div>
              {{
                await it.comp.ui.WebmentionComments({
                  mentions: it.interactions,
                }) |> safe
              }}
            </div>
          {{ /if }}
        {{ /if }}
      </div>
    {{ /if }}

    {{ if hasRelated }}
      <div class="page-footer__supplemental">
        <div id="related">
          {{ it.related |> safe }}
        </div>
      </div>
    {{ /if }}
  </footer>
{{ /if }}
