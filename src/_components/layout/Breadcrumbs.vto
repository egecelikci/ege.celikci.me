{{#
  Component: Breadcrumbs (System Component)
  Minimalist text-only breadcrumbs including site root and hierarchical bridging.

  Props:
    - it.url: string (required)
    - it.classes: additional classes
    - it.navigation: optional structure override
    - it.crumbSuffix: optional raw HTML appended after the trail
      (e.g. a live section indicator)
#}}

{{ set breadcrumbItems = nav.breadcrumb(it.url) }}

{{
  set breadcrumbItems = breadcrumbItems
  |> filter((item) => !['en', 'tr'].includes(item.slug))
}}

{{ if it.navigation?.parent }}
  {{ set parentTrail = nav.breadcrumb(it.navigation.parent) }}

  {{ if parentTrail.length <= 1 && it.navigation.parent !== "/" }}
    {{ set rootNode = nav.breadcrumb("/")[0] }}
    {{
      set manualParentTitle = it.navigation.parentTitle ||
      it.navigation.parent.split("/").filter(Boolean).pop()
    }}
    {{
      set parentTrail = [
        rootNode,
        {
          data: { url: it.navigation.parent, title: manualParentTitle },
          slug: manualParentTitle,
        },
      ].filter(Boolean)
    }}
  {{ /if }}

  {{ set currentItem = breadcrumbItems[breadcrumbItems.length - 1] }}

  {{ if !currentItem || currentItem.data?.url !== it.url }}
    {{
      set currentItem = {
        data: { url: it.url, title: it.title, type: it.type },
        slug: it.url.split("/").filter(Boolean).pop(),
      }
    }}
  {{ /if }}

  {{ set breadcrumbItems = [...parentTrail, currentItem] }}
{{ /if }}

<nav
  aria-label="Breadcrumb"
  class="breadcrumb {{ it.classes }}"
  itemprop="breadcrumb"
  itemscope
  itemtype="https://schema.org/BreadcrumbList"
>
  <ol class="breadcrumb__list">
    <li
      class="breadcrumb__item"
      itemprop="itemListElement"
      itemscope
      itemtype="https://schema.org/ListItem"
    >
      <meta itemprop="position" content="1">
      {{ if it.url === "/" }}
        <span class="breadcrumb__root" itemprop="name">
          {{ site.host }}
        </span>
      {{ else }}
        <a
          href="/"
          rel="home"
          class="breadcrumb__root"
          itemprop="url"
        >
          <span itemprop="name">{{ site.host }}</span>
        </a>
      {{ /if }}

      {{ if breadcrumbItems.length > 1 }}
        <span class="breadcrumb__sep">/</span>
      {{ /if }}
    </li>

    {{ for index, item of breadcrumbItems }}
      {{ if item.data?.url === "/" }}{{ continue }}{{ /if }}
      {{ set itemData = item.data || {} }}
      {{ set isLast = index === breadcrumbItems.length - 1 }}
      {{
        set itemTitle = (isLast ? (it.title || itemData.title) : itemData.title) ||
        item.slug || "page"
      }}

      <li
        class="breadcrumb__item {{ if isLast }}breadcrumb__item--current{{ /if }}"
        itemprop="itemListElement"
        itemscope
        itemtype="https://schema.org/ListItem"
      >
        <meta itemprop="position" content="{{ index + 1 }}">
        {{ if isLast }}
          <span
            class="breadcrumb__current"
            title="{{ itemTitle }}"
            itemprop="name"
          >
            {{ itemTitle }}
          </span>
        {{ else }}
          <a
            href='{{ itemData.url || "#" }}'
            class="breadcrumb__link"
            itemprop="url"
          >
            <span itemprop="name">{{ itemTitle }}</span>
          </a>
        {{ /if }}

        {{ if index < breadcrumbItems.length - 1 }}
          <span class="breadcrumb__sep breadcrumb__sep--faded">/</span>
        {{ /if }}
      </li>
    {{ /for }}
    {{ if it.crumbSuffix }}
      <li class="breadcrumb__item">
        <span class="breadcrumb__sep breadcrumb__sep--faded">#</span>
        {{ it.crumbSuffix |> safe }}
      </li>
    {{ /if }}
  </ol>
</nav>
