{{>
  const rawSources = it.sources || (it.label
    ? [{
      label: it.label,
      url: it.url || it.targetUrl,
      icon: it.icon || "database",
      catalog: it.catalog,
      type: it.type,
    }]
    : []);

  const processed = rawSources.map((s) => {
    const isFeed = s.type === "feed" ||
      s.label?.toLowerCase().includes("feed") ||
      s.url?.endsWith(".atom") ||
      s.url?.endsWith(".json");

    return {
      ...s,
      type: isFeed ? "feed" : "source",
      label: s.label || (isFeed ? "Feed" : "Source"),
      icon: s.icon || (isFeed ? "rss" : "database"),
    };
  });

  const variantVal = it.variant || "full";
  const feeds = processed.filter((s) => s.type === "feed");
  const nonFeeds = processed.filter((s) => s.type === "source")
}}

<div
  class="source-meta {{ if variantVal === 'minimal' }}source-meta--minimal{{ /if }}"
>
  {{ for source of nonFeeds }}
    {{> let targetUrl = source.url }}

    {{ if variantVal === "minimal" }}
      {{ if targetUrl }}
        <a
          href="{{ targetUrl }}"
          target="_blank"
          class="source-meta__icon-btn"
          title="{{ source.label }}"
        >
          {{
            await it.comp.base.Icon({
              name: source.icon,
              catalog: source.catalog ||
                (source.icon?.includes("musicbrainz") || source.icon?.includes("instagram")
                  ? "simpleicons"
                  : "lucide"),
              classes: "w-4 h-4",
            })
          }}
          <span class="sr-only">{{ source.label }}</span>
        </a>
      {{ /if }}
    {{ else }}
      <div class="source-meta__row">
        <div class="source-meta__badge">
          {{
            await it.comp.base.Icon({
              name: source.icon,
              classes: "w-3 h-3 source-meta__icon",
            })
          }}
        </div>
        <p class="source-meta__text">
          {{ if targetUrl }}
            {{ source.prefix || "Synced from" }} <a
              href="{{ targetUrl }}"
              target="_blank"
              class="source-meta__link"
            >{{ source.label }}</a>
          {{ else }}
            {{ source.prefix || "Source:" }} {{ source.label }}
          {{ /if }}
        </p>
      </div>
    {{ /if }}
  {{ /for }}

  {{ if feeds.length > 0 }}
    {{ if variantVal === "minimal" }}
      <div class="source-meta__feeds">
        {{ for feed of feeds }}
          <a
            href="{{ feed.url }}"
            target="_blank"
            class="source-meta__icon-btn"
            title="Subscribe via {{ feed.label }}"
          >
            {{
              await it.comp.base.Icon({
                name: feed.icon,
                classes: "w-4 h-4",
              })
            }}
            <span class="sr-only">Subscribe via {{ feed.label }}</span>
          </a>
        {{ /for }}
      </div>
    {{ else }}
      <div class="source-meta__row">
        <div class="source-meta__badge">
          {{
            await it.comp.base.Icon({
              name: feeds[0].icon,
              classes: "w-3 h-3 source-meta__icon",
            })
          }}
        </div>
        <p class="source-meta__text">
          Subscribe via
          {{ for i, feed of feeds }}
            {{ if i > 0 }}<span class="source-meta__separator">|</span>{{ /if }}
            <a
              href="{{ feed.url }}"
              target="_blank"
              class="source-meta__link"
            >{{ feed.label.replace(/ feed/i, "") }}</a>
          {{ /for }}
        </p>
      </div>
    {{ /if }}
  {{ /if }}
</div>
