{{#
  Component: EmptyState (Primitive)
  A refined, minimal placeholder for empty lists or results.
  Aligned with the site's "slim" design language.

  Props:
    - icon: string (optional)
    - title: string (optional)
    - description: string (optional)
#}}

<div class="empty-state not-prose">
  {{ if it.icon }}
    <span class="empty-state__icon">
      {{
        await it.comp.base.Icon({
          name: it.icon,
          catalog: "lucide",
          classes: "w-5 h-5",
        })
      }}
    </span>
  {{ /if }}

  <span class="empty-state__title">
    {{ it.title || "no results" }}
  </span>

  {{ if it.description }}
    <p class="empty-state__desc">
      {{ it.description |> safe }}
    </p>
  {{ /if }}
</div>
