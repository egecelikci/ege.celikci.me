{{#
  Component: Icon
  Lume-native icon loader using the icons plugin's SVG sprite feature.
#}}
{{- set defaultClasses = "icon" -}}
{{- set strokeClasses = !it.filled && (it.catalog === "lucide" || !it.catalog) ? "icon--stroke" : "icon--fill" -}}
<svg
  class="{{ defaultClasses }} {{ strokeClasses }} {{ it.classes || "" }}"
  data-catalog="{{ it.catalog || "lucide" }}"
>
  <use href="{{ it.name |> spriteIcon(it.catalog || 'lucide') }}"></use>
</svg>
