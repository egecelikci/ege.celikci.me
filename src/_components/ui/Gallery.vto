{{#
  Component: Gallery (Content-aware wrapper)
  Reworked: Cinematic, accessible gallery for a "chill" visual diary.

  Props:
    - images: Array of { src, alt, width, height, photographer? }
    - static: boolean (default: false)
    - classes: additional classes
    - aspect: "square" | "video" (default: "square")
#}}

{{ if it.images && it.images.length > 0 }}
  {{ set isSingle = it.images.length == 1 }}
  {{
    set gridClasses = isSingle ? "gallery gallery--single" : "gallery"
  }}
  {{ set gid = it.groupId || it.images[0].src |> slugify }}

  <div
  class="{{ gridClasses }} {{ it.classes }}"
  {{ if !it.static }} data-lightbox-group="{{ gid }}" {{ /if }}
>
    {{ for i, image of it.images }}
      <div class="gallery__item">
        {{# 1. WRAPPER ELEMENT #}}
        {{ if !it.static }}
          <a
            href="{{ image.src |> url }}"
            {{ if image.width }}data-pswp-width="{{ image.width }}"{{ /if }}
            {{ if image.height }}data-pswp-height="{{ image.height }}"{{ /if }}
            data-cropped="true"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="View larger image{{ if image.alt?.trim() }}: {{ image.alt |> escape }}{{ /if }}"
            class="lightbox-trigger note-gallery__link ledger-card gallery__link gallery__link--{{ it.aspect || "square" }}"
          >
            {{# 2. THE IMAGE #}}
            <img
              src="{{ image.src |> url }}"
              alt="{{ image.alt |> escape }}"
              image-size
              transform-images="avif webp jpg 640 1280 1920"
              class="gallery__img"
              loading="lazy"
              decoding="async"
            />

            {{# 4. CAPTION (Optional) #}}
            {{ if image.alt?.trim() }}
              <span class="sr-only">{{ image.alt |> escape }}</span>
            {{ /if }}
          </a>
        {{ else }}
          <div
            class="note-gallery__link ledger-card gallery__link gallery__link--{{ it.aspect || "square" }}"
          >
            {{# 2. THE IMAGE #}}
            <img
              src="{{ image.src |> url }}"
              alt="{{ image.alt |> escape }}"
              image-size
              transform-images="avif webp jpg 640 1280 1920"
              class="gallery__img"
              loading="lazy"
              decoding="async"
            />
          </div>
        {{ /if }}

        {{# 3. MINIMALIST OVERLAY #}}
        {{ if it.images.length > 1 }}
          <div
            class="gallery__overlay"
          >
            <div class="gallery__overlay-row">
              {{ await it.comp.base.Icon({ name: "layers", classes: "w-3 h-3" }) }}
              <span>{{ i + 1 }} / {{ it.images.length }}</span>
            </div>
          </div>
        {{ /if }}

        {{# 4. PHOTOGRAPHER CREDIT CHIP #}}
        {{ if image.photographer?.name }}
          <span class="gallery__credit">
            {{- image.photographer.name -}}
          </span>
        {{ /if }}
      </div>
    {{ /for }}
  </div>
{{ /if }}
