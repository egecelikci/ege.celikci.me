{{#
  Component: Media
  Content-aware media grid for notes and listings.

  Props:
    - images: Array of { src, alt, width?, height?, type? }
    - aspect: "auto" | "eq1" | "eq2" | "eq3" | "eq4" (default: auto-derived from count)
    - limit: number | null (default: null = show all; listings pass 4)
    - static: boolean (default: false)
    - card: boolean (default: false; true renders the ledger-card chrome)
    - postUrl: link the +N tile (and media) to a note
    - classes: additional classes
#}}

{{ if it.images && it.images.length > 0 }}
  {{ set total = it.images.length }}
  {{ set limit = it.limit ?? 9999 }}
  {{ set count = Math.min(total, limit) }}
  {{ set remaining = total - count }}
  {{ set hasMore = remaining > 0 }}
  {{ set isAuto = it.aspect === "auto" }}
  {{ set isFlow = !isAuto && count > 4 }}
  {{
    set gridClass = isAuto
      ? "media-grid--auto"
      : (isFlow
        ? "media-grid--flow"
        : (it.aspect || {
          "eq1": "media-grid--eq1",
          "eq2": "media-grid--eq2",
          "eq3": "media-grid--eq3",
          "eq4": "media-grid--eq4",
        }["eq" + count]))
  }}

  <div
  class="media-grid {{ gridClass }}{{ if it.card }} ledger-card{{ /if }}"
  data-lightbox-group="{{ it.images[0].src |> slugify }}"
>
    {{ for i, image of it.images |> slice(0, count) }}
      {{
        set isPanoramic = image.width && image.height && (image.width / image.height > 2)
      }}
      {{ set itemClass = "" }}
      {{ if isPanoramic && !isAuto }}
        {{ set itemClass = "media--span-full" }}
      {{ /if }}
      {{ if !isFlow && count === 3 && i === 0 && !isAuto && itemClass === "" }}
        {{ set itemClass = "media--span-row" }}
      {{ /if }}
      {{ set isMore = hasMore && i === count - 1 }}
      {{ set isMoreLink = isMore && it.postUrl }}
      {{ set tileHref = it.postUrl || image.src }}

      <a
        href="{{ tileHref |> url }}"
        class="media {{ if !isMoreLink }}lightbox-trigger {{ /if }}{{ if isAuto }}media--auto {{ /if }}{{ if isMore }}media--more {{ /if }}{{ itemClass }}"
        {{ if isMore }}
          aria-label="View {{ remaining }} more {{ remaining === 1 ? "photo" : "photos" }}"
        {{ else }}
          aria-label="{{ (image.alt || 'view image') |> escape }}"
          target="_blank"
          rel="noopener noreferrer"
          data-src="{{ image.src |> url }}"
          {{ if image.width }}data-pswp-width="{{ image.width }}"{{ /if }}
          {{ if image.height }}data-pswp-height="{{ image.height }}"{{ /if }}
          data-cropped="true"
          data-orientation="{{ (image.width && image.height) ? (image.width > image.height ? 'landscape' : 'portrait') : 'landscape' }}"
          data-media-type="{{ image.type || "image" }}"
          {{ if it.postUrl }}data-post-url="{{ it.postUrl |> url }}"{{ /if }}
        {{ /if }}
      >
        <img
          src="{{ image.src |> url }}"
          alt="{{ image.alt |> escape }}"
          image-size
          transform-images="avif webp jpg 640 1280 1920"
          loading="lazy"
          decoding="async"
          class="media__img"
        />

        {{ if !isMore }}
          {{ set caption = (image.alt || "").split("\n")[0] |> trim }}
          {{ if caption }}
            <div class="media-caption">
              <p>{{ caption |> escape }}</p>
            </div>

            <div class="alt-badge" data-pagefind-ignore>ALT</div>
          {{ /if }}
        {{ /if }}

        {{ if isMore }}
          <div class="media-more" aria-hidden="true">
            <span class="media-more__count">+{{ remaining }}</span>
          </div>
        {{ /if }}
      </a>
    {{ /for }}
  </div>
{{ /if }}
