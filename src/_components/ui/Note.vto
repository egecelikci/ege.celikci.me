{{ set vtoContext = { ...it.note, author: it.author, site: it.site, comp: it.comp } }}
{{ set hasImages = it.note.images && it.note.images.length > 0 }}

<article class="h-entry note">
  {{ if !it.hideHeader }}
    <header class="note__meta">
      <time class="dt-published typography-sublabel">
        {{ it.note.date |> date("dd MMM yyyy · HH:mm") }}
      </time>
      <div class="divider"></div>
      {{ if it.note.tags }}
        <div class="note__tags">
          {{ for tag of it.note.tags |> slice(0, 3) }}
            <span class="typography-sublabel">#{{ tag }}</span>
          {{ /for }}
        </div>
      {{ /if }}
    </header>
  {{ /if }}

  {{ if hasImages }}
    {{
      await it.comp.ui.Media({
        images: it.note.images,
        postUrl: it.note.url,
        limit: null,
        aspect: it.note.images.length === 1 ? "auto" : undefined,
      })
    }}
  {{ /if }}

  <div class="note__body">
    {{ if it.note.title && !it.hideHeader }}
      <h2 class="p-name note__title">{{ it.note.title }}</h2>
    {{ /if }}
    <div class="e-content markdown">
      {{ it.note.content |> vto(vtoContext) |> md |> safe }}
    </div>
  </div>
</article>
