{{#
  Component: ActivityMeta
  Unified display for interaction stats and syndication links.
  Consolidates NoteStats and Syndication atoms.

  Props:
    - stats: { replies: number, reposts: number, likes: number }
    - syndication: { bluesky?: string, mastodon?: string, instagram?: string }
    - classes: string
#}}

<div class="activity-meta {{ it.classes }}">
  {{ if it.stats && (it.stats.replies > 0 || it.stats.reposts > 0 || it.stats.likes > 0) }}
    <ul class="activity-meta__stats">
      <li
        class="activity-meta__stat"
        title="{{ it.stats.replies }} mentions"
      >
        {{
          await it.comp.base.Icon({
            name: "message-square",
          })
        }}
        <span>{{ it.stats.replies |> humanizeNumber }}</span>
      </li>
      <li
        class="activity-meta__stat"
        title="{{ it.stats.reposts }} reposts"
      >
        {{ await it.comp.base.Icon({ name: "repeat-2" }) }}
        <span>{{ it.stats.reposts |> humanizeNumber }}</span>
      </li>
      <li
        class="activity-meta__stat"
        title="{{ it.stats.likes }} likes"
      >
        {{ await it.comp.base.Icon({ name: "heart" }) }}
        <span>{{ it.stats.likes |> humanizeNumber }}</span>
      </li>
    </ul>
  {{ /if }}

  {{ if it.syndication }}
    {{ if it.stats && (it.stats.replies > 0 || it.stats.reposts > 0 || it.stats.likes > 0) }}
      <div class="activity-meta__divider"></div>
    {{ /if }}
    <div class="activity-meta__syndication">
      {{ if it.syndication.bluesky }}
        <a
          href="{{ it.syndication.bluesky }}"
          class="u-syndication activity-meta__syndication-link activity-meta__syndication-link--bluesky"
          aria-label="View on Bluesky"
          title="View on Bluesky"
          target="_blank"
          rel="noopener noreferrer syndication"
        >
          {{
            await it.comp.base.Icon({
              name: "bluesky",
              catalog: "simpleicons",
              classes: "w-4 h-4 fill-current",
            })
          }}
        </a>
      {{ /if }}

      {{ if it.syndication.mastodon }}
        <a
          href="{{ it.syndication.mastodon }}"
          class="u-syndication activity-meta__syndication-link activity-meta__syndication-link--mastodon"
          aria-label="View on Mastodon"
          title="View on Mastodon"
          target="_blank"
          rel="noopener noreferrer syndication"
        >
          {{
            await it.comp.base.Icon({
              name: "mastodon",
              catalog: "simpleicons",
              classes: "w-4 h-4 fill-current",
            })
          }}
        </a>
      {{ /if }}

      {{ if it.syndication.instagram }}
        <a
          href="{{ it.syndication.instagram }}"
          class="u-syndication activity-meta__syndication-link activity-meta__syndication-link--instagram"
          aria-label="View on Instagram"
          title="View on Instagram"
          target="_blank"
          rel="noopener noreferrer syndication"
        >
          {{
            await it.comp.base.Icon({
              name: "instagram",
              catalog: "simpleicons",
              classes: "w-4 h-4 fill-current",
            })
          }}
        </a>
      {{ /if }}
    </div>
  {{ /if }}
</div>
