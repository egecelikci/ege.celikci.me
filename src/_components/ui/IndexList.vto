{{#
  Props:
    - items: Array<{
        title: string,
        href?: string,
        desc?: string,
        marker?: string,
        type?: "section" | "item",
        children?: Array<{ title: string, href: string, desc: string }>
      }>
#}}

<div class="index-list {{ it.classes || "" }}">
  <ul class="index-list__group">
    {{ for item of it.items }}
      {{ if item.type === "section" }}
        <li class="index-list__section">
          <span class="index-list__section-label">
            {{ item.title |> safe }}
          </span>
        </li>
      {{ else }}
        {{# --- LEDGER ENTRY --- #}}
        <li
          class="index-list__row {{ if item.href }}index-list__row--link{{ /if }}"
        >
          <a
            {{ if item.href }}href="{{ item.href }}"{{ /if }}
            class="index-list__link {{ if item.href }}index-list__link--href{{ else }}index-list__link--static{{ /if }}"
          >
            <span class="index-list__marker">
              {{ item.marker || "··" }}
            </span>

            <span class="index-list__title">
              {{ item.title |> safe }}
            </span>

            <span class="index-list__connector"></span>

            <span class="index-list__desc">
              {{ item.desc |> safe }}
            </span>
          </a>

          {{ if item.extra }}
            <div class="index-list__extra">
              {{ item.extra |> safe }}
            </div>
          {{ /if }}
        </li>

        {{ if item.children && item.children.length > 0 }}
          <li class="index-list__children">
            <ul class="index-list__child-group">
              {{ for child of item.children }}
                <li class="index-list__child-row">
                  <a
                    {{ if child.href }}href="{{ child.href }}"{{ /if }}
                    class="index-list__child-link {{ if child.href }}index-list__child-link--href{{ else }}index-list__child-link--static{{ /if }}"
                  >
                    <div class="index-list__child-rail"></div>

                    <span class="index-list__child-title">
                      {{ child.title |> safe }}
                    </span>

                    <span class="index-list__child-connector"></span>

                    <span class="index-list__child-desc">
                      {{ child.desc |> safe }}
                    </span>
                  </a>

                  {{ if child.extra }}
                    <div class="index-list__extra">
                      {{ child.extra |> safe }}
                    </div>
                  {{ /if }}
                </li>
              {{ /for }}
            </ul>
          </li>
        {{ /if }}
      {{ /if }}
    {{ /for }}
  </ul>
</div>
