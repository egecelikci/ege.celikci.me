{{ if it.entries && it.entries.length > 0 }}
  {{>
    const groupBy = it.groupBy || "month";
    // dates may arrive as strings (frontmatter) or Date objects (Lume)
    const dateOf = (item) => item.date instanceof Date ? item.date : new Date(item.date);
    const grouped = groupBy === "none" ? { "all": it.entries } : Object.groupBy(
      it.entries,
      (item) => {
        if (groupBy === "year") {
          return dateOf(item).getFullYear().toString();
        }
        return dateOf(item).toLocaleDateString("en-GB", {
          month: "long",
          year: "numeric",
        });
      },
    );
    const dateKeys = Object.keys(grouped)
  }}

  <div class="h-feed entry-timeline">
    {{ for dateKey of dateKeys }}
      <section class="entry-timeline__group">
        {{ if groupBy !== "none" }}
          {{
            await it.comp.ui.SectionHeader({
              title: dateKey,
              variant: groupBy === "year" ? "large" : "label",
            })
          }}
        {{ /if }}

        <div class="entry-timeline__list">
          {{ for item of grouped[dateKey] }}
            {{
              await it.comp.ui.EntryRow({
                entry: item,
                showDate: true,
                hideLabel: it.hideRowLabel,
                hideYear: groupBy === "year",
              })
            }}
          {{ /for }}
        </div>
      </section>
    {{ /for }}
  </div>
{{ /if }}
