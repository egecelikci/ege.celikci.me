<!-- deno-fmt-ignore-file -->
{{#
  Component: Video (Universal Wrapper)
  Displays a video (YouTube, PeerTube, etc.) with click-to-load functionality.
#}}
{{- set safeTitle = title || "video" -}}

{{- if id -}}
  {{-
    set embedUrl = "https://www.youtube-nocookie.com/embed/" + id + "?autoplay=1"
  -}}
  {{- set providerName = "YouTube" -}}
{{- else -}}
  {{- set embedUrl = src -}}
  {{- if src && src.includes("youtube.com") -}}
    {{- set providerName = "YouTube" -}}
  {{-
    else if src && (src.includes("peertube") || src.includes("v.basspistol.org"))
  -}}
    {{- set providerName = "PeerTube" -}}
    {{- if !embedUrl.includes("autoplay=1") -}}
      {{-
        set embedUrl = embedUrl + (embedUrl.includes("?") ? "&" : "?") + "autoplay=1"
      -}}
    {{- /if -}}
  {{- else -}}
    {{- set providerName = provider || "video" -}}
  {{- /if -}}
{{- /if -}}

{{-
  set iframe = `<iframe class='video-iframe' src='${embedUrl}' title='${safeTitle}' frameborder='0' allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen' sandbox='allow-same-origin allow-scripts allow-popups allow-forms' allowfullscreen></iframe>`
-}}

{{- set cardContent -}}
<div class="video-card" data-embed="{{ iframe |> escape }}" onclick="this.innerHTML = this.dataset.embed">
<div class="video-card__title">{{ safeTitle }}</div>
<div class="video-card__play">
{{ await it.comp.base.Icon({ name: "play", catalog: "lucide", classes: "w-4 h-4" }) -}}
<span>Click to load video from {{ providerName }}</span>
</div>
</div>
{{- if credits?.length > 0 }}
<div class="media-credits media-credits--card">
{{- for credit of credits }}
<div class="media-credits__row">
<span class="media-credits__label">{{ credit.role }}</span>
{{- if credit.url }}
<a href="{{ credit.url }}" target="_blank" class="media-credits__name">{{ credit.name }}</a>
{{- else }}
<span class="media-credits__name">{{ credit.name }}</span>
{{- /if }}
</div>
{{- /for }}
</div>
{{- /if }}
{{- /set -}}

{{- await it.comp.ui.Card({
    classes: "my-6 p-0 overflow-hidden " + (it.classes || ""),
    attributes: it.attributes,
    content: cardContent,
  }) -}}
