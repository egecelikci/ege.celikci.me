{{#
  Component: Video (Universal Wrapper)
  Displays a video (YouTube, PeerTube, etc.) with click-to-load functionality.
  Requires `id` or `src`; renders nothing without either.
#}}
{{- set safeTitle = it.title || "video" -}}

{{- if it.id -}}
  {{-
    set embedUrl = "https://www.youtube-nocookie.com/embed/" + it.id + "?autoplay=1"
  -}}
  {{- set providerName = "YouTube" -}}
{{- else -}}
  {{- set embedUrl = it.src -}}
  {{- if it.src && it.src.includes("youtube.com") -}}
    {{- set providerName = "YouTube" -}}
  {{-
    else if it.src && (it.src.includes("peertube") || it.src.includes("v.basspistol.org"))
  -}}
    {{- set providerName = "PeerTube" -}}
    {{- if !embedUrl.includes("autoplay=1") -}}
      {{-
        set embedUrl = embedUrl + (embedUrl.includes("?") ? "&" : "?") + "autoplay=1"
      -}}
    {{- /if -}}
  {{- else -}}
    {{- set providerName = it.provider || "video" -}}
  {{- /if -}}
{{- /if -}}

{{- set cardContent -}}
{{# A button so keyboards can start it; main.ts builds the iframe from these attributes with DOM calls, never from an HTML string. #}}
<button type="button" class="video-card" data-embed-src="{{ embedUrl }}" data-embed-title="{{ safeTitle }}">
<span class="video-card__title">{{ safeTitle }}</span>
<span class="video-card__play">
{{ await it.comp.base.Icon({ name: "play", catalog: "lucide", classes: "w-4 h-4" }) |> safe -}}
<span>Click to load video from {{ providerName }}</span>
</span>
</button>
{{- if credits?.length > 0 }}
<div class="media-credits media-credits--card">
{{- for credit of credits }}
<div class="media-credits__row">
<span class="media-credits__label">{{ credit.role }}</span>
{{- if credit.url }}
<a href="{{ credit.url }}" target="_blank" class="media-credits__name">{{ credit.name }}</a>
{{- else }}
<span class="media-credits__name">{{ credit.name }}</span>
{{- /if }}
</div>
{{- /for }}
</div>
{{- /if }}
{{- /set -}}

{{- if it.id || it.src -}}
{{- await it.comp.ui.Card({
    classes: "ledger-card--flush " + (it.classes || ""),
    attributes: it.attributes,
    content: cardContent,
  }) |> safe -}}
{{- /if -}}
