{{>
  const idRegex = /([a-f0-9-]{36})/;

  const decodeEntities = (str) =>
    str
      .replace(/&lsqb;/g, "[")
      .replace(/&rsqb;/g, "]")
      .replace(/&lbrack;/g, "[")
      .replace(/&rbrack;/g, "]")
      .replace(/&amp;/g, "&")
      .replace(/&AMP;/g, "&")
      .replace(/&#91;/g, "[")
      .replace(/&#93;/g, "]")
      .replace(/&#x5b;/g, "[")
      .replace(/&#x5d;/g, "]")
      .replace(/&#38;/g, "&")
      .replace(/&#x26;/g, "&");

  const parseMBLink = (str) => {
    const m = str.match(/\[([^|\]]+)\|([^\]]+)\]/);
    if (!m) return { id: null, name: decodeEntities(str) };

    const rawId = m[1];
    const name = decodeEntities(m[2]);
    const mbidMatch = rawId.match(idRegex);
    const mbid = mbidMatch ? mbidMatch[1] : rawId;

    return { id: mbid, name };
  };

  const content = it.content || "";
  const groups = [];
  let current = null;

  if (content) {
    const lines = content.split(/\r?\n/);
    for (const line of lines) {
      const trimmed = line.trim();
      if (!trimmed) continue;

      if (trimmed.startsWith("@")) {
        const { id, name } = parseMBLink(trimmed.substring(1).trim());
        current = { id, name, flow: [] };
        groups.push(current);
      } else if (trimmed.startsWith("*")) {
        if (!current) {
          current = { id: null, name: null, flow: [] };
          groups.push(current);
        }
        const { id, name } = parseMBLink(trimmed.substring(1).trim());
        current.flow.push({ type: "track", workId: id, title: name });
      } else if (trimmed.startsWith("#")) {
        const note = decodeEntities(trimmed.substring(1).trim());
        if (current) {
          current.flow.push({ type: "info", title: note });
        }
      }
    }
  }

  const items = [];

  for (const group of groups) {
    const artistMBUrl = group.id
      ? `https://listenbrainz.org/artist/${group.id}`
      : null;

    const sectionTitle = `<b>${
      artistMBUrl
        ? `<a href="${artistMBUrl}" class="setlist__artist-link">${group.name}</a>`
        : group.name || "Setlist"
    }</b>`;

    let counter = 1;
    for (const entry of group.flow) {
      if (entry.type === "info") {
        items.push({ type: "info", title: entry.title });
        continue;
      }

      if (counter === 1) {
        items.push({ type: "section", title: sectionTitle });
      }

      const workUrl = entry.workId
        ? `https://musicbrainz.org/work/${entry.workId}`
        : null;

      items.push({
        title: `<i>${entry.title}</i>`,
        ...(workUrl ? { href: workUrl } : {}),
        marker: String(counter++).padStart(2, "0") + ".",
      });
    }
  }
}}

<div class="index-list {{ it.classes || " " }}">
  <ul class="index-list__group">
    {{ for item of items }}
      {{ if item.type === "section" }}
        <li class="index-list__section">
          <span class="index-list__section-label">
            {{ item.title |> safe }}
          </span>
        </li>
      {{ else if item.type === "info" }}
        <li class="index-list__info">
          <span class="index-list__info-label">
            {{ item.title |> safe }}
          </span>
        </li>
      {{ else }}
        <li
          class="index-list__row {{ if item.href }}index-list__row--link{{ /if }}"
        >
          <a
            {{ if item.href }}href="{{ item.href }}"{{ /if }}
            class="index-list__link {{ if item.href }}index-list__link--href{{ else }}index-list__link--static{{ /if }}"
          >
            <span class="index-list__marker">
              {{ item.marker || "··" }}
            </span>

            <span class="index-list__title">
              {{ item.title |> safe }}
            </span>

            <span class="index-list__connector"></span>

            <span class="index-list__desc">
              {{ item.desc |> safe }}
            </span>
          </a>

          {{ if item.extra }}
            <div class="index-list__extra">
              {{ item.extra |> safe }}
            </div>
          {{ /if }}
        </li>
      {{ /if }}
    {{ /for }}
  </ul>
</div>
