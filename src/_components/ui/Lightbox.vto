{{#
  Component: Lightbox (Templates for PhotoSwipe)
  Provides UI blueprints for PhotoSwipe using existing design tokens.
#}}
{{# 1. TOP CONTROLS TEMPLATE #}}
<template id="pswp-template-controls">
  <div
    class="carousel-top-controls"
  >
    {{# Close #}}
    <div>
      <button
        type="button"
        class="btn-icon pswp-close-btn"
        aria-label="Close media viewer"
      >
        {{ await it.comp.base.Icon({ name: "x", classes: "w-5 h-5" }) }}
      </button>
    </div>

    {{# Dots & Counter #}}
    <div
      class="carousel-indicator"
    >
      <span
        class="carousel-dots pswp-dots"
      >
        {{# dots injected by JS #}}
      </span>
      <span
        class="carousel-counter pswp-counter hidden"
        aria-live="polite"
        aria-atomic="true"
      >
        {{# counter injected by JS #}}
      </span>
    </div>

    {{# More menu #}}
    <div>
      <div class="pswp-more-wrap">
        <button
          type="button"
          class="btn-icon pswp-more-btn"
          aria-label="More options"
          aria-haspopup="menu"
        >
          {{ await it.comp.base.Icon({ name: "more-horizontal", classes: "w-5 h-5" }) }}
        </button>

        <div
          class="menu opacity-0 pointer-events-none scale-95 pswp-more-menu"
          role="menu"
        >
          <a
            href="#"
            class="menu__item pswp-view-post hidden"
            role="menuitem"
          >
            {{ await it.comp.base.Icon({ name: "message-square", classes: "w-4 h-4" }) }}
            <span>View post</span>
          </a>
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="menu__item pswp-open-original"
            role="menuitem"
          >
            {{ await it.comp.base.Icon({ name: "external-link", classes: "w-4 h-4" }) }}
            <span>Open original</span>
          </a>
          <button
            type="button"
            class="menu__item pswp-download"
            role="menuitem"
          >
            {{ await it.comp.base.Icon({ name: "download", classes: "w-4 h-4" }) }}
            <span>Download</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</template>

{{# 2. ALT TRIGGER TEMPLATE #}}
<template id="pswp-template-alt">
  <div
    class="media-alt opacity-0 pointer-events-none pswp-alt-trigger"
  >
    <button
      type="button"
      aria-label="Read media description"
    >
      <span class="media-alt__badge">ALT</span>
      <span class="pswp-caption-preview"></span>
    </button>
  </div>
</template>

{{# 3. ALT SHEET TEMPLATE #}}
<template id="pswp-template-sheet">
  <div>
    <div
      class="pswp-sheet-backdrop opacity-0 pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div
      class="pswp-sheet translate-y-full opacity-0 pointer-events-none"
      role="dialog"
      aria-labelledby="pswp-sheet-title"
      aria-modal="true"
    >
      <div class="pswp-sheet-header">
        <h2
          id="pswp-sheet-title"
          class="pswp-sheet-title"
        >
          Media description
        </h2>
        <button
          type="button"
          class="btn-icon pswp-sheet-close"
          aria-label="Close description"
        >
          {{ await it.comp.base.Icon({ name: "x", classes: "w-5 h-5" }) }}
        </button>
      </div>
      <div
        class="pswp-sheet-content"
      >
        {{# Alt text injected here by JS #}}
      </div>
    </div>
  </div>
</template>

{{# 4. DOT TEMPLATE #}}
<template id="pswp-template-dot">
  <button
    type="button"
    class="carousel-dot pswp-dot"
    aria-label="Go to slide"
  >
    •
  </button>
</template>

{{# 5. NAVIGATION ARROWS #}}
<template id="pswp-template-nav">
  <div class="pswp-nav">
    <button
      type="button"
      class="btn-icon pswp-prev"
      aria-label="Previous image"
    >
      {{ await it.comp.base.Icon({ name: "chevron-left", classes: "w-6 h-6" }) }}
    </button>
    <button
      type="button"
      class="btn-icon pswp-next"
      aria-label="Next image"
    >
      {{ await it.comp.base.Icon({ name: "chevron-right", classes: "w-6 h-6" }) }}
    </button>
  </div>
</template>
