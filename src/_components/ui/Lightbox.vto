{{#
  Component: Lightbox (Templates for PhotoSwipe)
  Provides UI blueprints for PhotoSwipe using existing design tokens.
#}}
{{# 1. TOP CONTROLS TEMPLATE #}}
<template id="pswp-template-controls">
  <div
    class="carousel-top-controls absolute top-0 left-0 right-0 p-6 md:p-10 flex justify-between items-center z-10 pointer-events-auto pt-[max(1.5rem,env(safe-area-inset-top))] px-[max(1.5rem,env(safe-area-inset-right,1.5rem))] pl-[max(1.5rem,env(safe-area-inset-left,1.5rem))]"
  >
    {{# Close #}}
    <span>
      <button
        type="button"
        class="carousel-button pswp-close-btn"
        aria-label="Close media viewer"
      >
        {{ await it.comp.base.Icon({ name: "x", classes: "w-5 h-5" }) }}
      </button>
    </span>

    {{# Dots & Counter #}}
    <div
      class="carousel-indicator"
    >
      <span
        class="carousel-dots pswp-dots"
      >
        {{# dots injected by JS #}}
      </span>
      <span
        class="carousel-counter pswp-counter hidden"
        aria-live="polite"
        aria-atomic="true"
      >
        {{# counter injected by JS #}}
      </span>
    </div>

    {{# More menu #}}
    <span class="flex items-center gap-2">
      <div class="relative">
        <button
          type="button"
          class="carousel-button pswp-more-btn"
          aria-label="More options"
          aria-haspopup="menu"
        >
          {{ await it.comp.base.Icon({ name: "more-horizontal", classes: "w-5 h-5" }) }}
        </button>

        <div
          class="carousel-menu opacity-0 pointer-events-none scale-95 pswp-more-menu"
          role="menu"
        >
          <a
            href="#"
            class="pswp-view-post hidden"
            role="menuitem"
          >
            {{ await it.comp.base.Icon({ name: "message-square", classes: "w-4 h-4" }) }}
            <span>View post</span>
          </a>
          <a
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="pswp-open-original"
            role="menuitem"
          >
            {{ await it.comp.base.Icon({ name: "external-link", classes: "w-4 h-4" }) }}
            <span>Open original</span>
          </a>
          <button
            type="button"
            class="pswp-download"
            role="menuitem"
          >
            {{ await it.comp.base.Icon({ name: "download", classes: "w-4 h-4" }) }}
            <span>Download</span>
          </button>
        </div>
      </div>
    </span>
  </div>
</template>

{{# 2. ALT TRIGGER TEMPLATE #}}
<template id="pswp-template-alt">
  <div
    class="media-alt opacity-0 pointer-events-none pswp-alt-trigger"
  >
    <button
      type="button"
      aria-label="Read media description"
    >
      <span class="media-alt__badge">ALT</span>
      <span class="pswp-caption-preview"></span>
    </button>
  </div>
</template>

{{# 3. ALT SHEET TEMPLATE #}}
<template id="pswp-template-sheet">
  <div>
    <div
      class="fixed inset-0 bg-black/40 backdrop-blur-sm z-[5100] transition-opacity duration-300 opacity-0 pointer-events-none pswp-sheet-backdrop"
      aria-hidden="true"
    >
    </div>
    <div
      class="fixed bottom-0 left-0 right-0 z-[5200] bg-surface border-t border-border rounded-t-3xl p-6 md:p-8 transform transition-transform duration-300 flex flex-col gap-6 max-h-[80vh] overflow-y-auto shadow-2xl md:max-w-2xl md:mx-auto md:mb-8 md:rounded-3xl md:border translate-y-full opacity-0 pointer-events-none pswp-sheet"
      role="dialog"
      aria-labelledby="pswp-sheet-title"
      aria-modal="true"
    >
      <header class="flex items-center justify-between gap-4">
        <h2
          id="pswp-sheet-title"
          class="text-xl font-bold tracking-tight text-text"
        >
          Media description
        </h2>
        <button
          type="button"
          class="p-2 rounded-full hover:bg-black/5 transition-colors pswp-sheet-close"
          aria-label="Close description"
        >
          {{ await it.comp.base.Icon({ name: "x", classes: "w-5 h-5" }) }}
        </button>
      </header>
      <main
        class="text-base leading-relaxed text-text-muted whitespace-pre-wrap text-pretty pswp-sheet-content"
      >
        {{# Alt text injected here by JS #}}
      </main>
    </div>
  </div>
</template>

{{# 4. DOT TEMPLATE #}}
<template id="pswp-template-dot">
  <button
    class="carousel-dot pswp-dot"
    aria-label="Go to slide"
  >
    •
  </button>
</template>

{{# 5. NAVIGATION ARROWS #}}
<template id="pswp-template-nav">
  <div class="pswp-nav">
    <button
      type="button"
      class="carousel-button pswp-prev"
      aria-label="Previous image"
    >
      {{ await it.comp.base.Icon({ name: "chevron-left", classes: "w-6 h-6" }) }}
    </button>
    <button
      type="button"
      class="carousel-button pswp-next"
      aria-label="Next image"
    >
      {{ await it.comp.base.Icon({ name: "chevron-right", classes: "w-6 h-6" }) }}
    </button>
  </div>
</template>
