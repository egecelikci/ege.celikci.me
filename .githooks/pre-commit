#!/bin/sh
# @file pre-commit
# @brief Runs the same checks as `pnpm run ci` before a commit, fastest first.
# @description Install with `pnpm run hooks`; skip once with `git commit --no-verify` or `SKIP_CHECKS=1`.
# Content-only commits run the formatter check alone.
set -u

[ "${SKIP_CHECKS:-0}" = 1 ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1

# @description Print a failure with the way to skip it, then abort the commit.
# @arg $1 string The reason.
# @exitcode 1 Always.
fail() {
  printf '\npre-commit: %s\n  skip once: git commit --no-verify\n' "$1" >&2
  exit 1
}

# Non-interactive shells (GUI clients, NixOS) often lack Homebrew or mise on PATH.
if ! command -v pnpm >/dev/null 2>&1; then
  if command -v mise >/dev/null 2>&1 && pnpm_path=$(mise which pnpm 2>/dev/null); then
    PATH="$(dirname "$pnpm_path"):$PATH" && export PATH
  elif [ -x /opt/homebrew/bin/pnpm ]; then
    PATH="/opt/homebrew/bin:$PATH" && export PATH
  else
    fail "pnpm not found on PATH"
  fi
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

code=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|js|mjs|vto|jsonc?|scss)$|^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|tsconfig\.json|\.oxfmtrc\.json|\.oxlintrc\.json|netlify\.toml)$' || true)

# The checks read the working tree, so a half-staged file would be checked in a state that is not being committed.
if [ -n "$code" ]; then
  partial=$(git diff --name-only | grep -Fx "$code" || true)
  if [ -n "$partial" ]; then
    fail "these files have unstaged changes, stage or stash them first:
$partial"
  fi
fi

# @description Run one package script, aborting the commit when it fails.
# @arg $1 string The script name.
run() {
  printf '› %s\n' "$1" >&2
  pnpm run --silent "$1" || fail "$1 failed"
}

run fmt:check
if [ -z "$code" ]; then
  echo "pre-commit: content only, skipped lint, check, and test" >&2
  exit 0
fi
run lint
run check
run test
