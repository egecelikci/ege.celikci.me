{
  "name": "ege.celikci.me",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "MODE=production lume build",
    "serve": "MODE=development lume build -s",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "check": "tsc -p .",
    "test": "node --test lib/ plugins/ jobs/ src/assets/scripts/",
    "ci": "pnpm run fmt:check && pnpm run lint && pnpm run check && pnpm run test",
    "deploy": "pnpm run ci && pnpm run build && netlify deploy --prod",
    "hooks": "node tools/install-hooks.ts",
    "tiles": "node jobs/tiles.ts"
  },
  "dependencies": {
    "@lumeland/core": "1.0.3",
    "@lumeland/lume": "4.0.1",
    "@lumeland/plugin-check-urls": "1.0.0",
    "@lumeland/plugin-date": "1.0.0",
    "@lumeland/plugin-esbuild": "1.0.0",
    "@lumeland/plugin-extract-date": "1.0.0",
    "@lumeland/plugin-favicon": "1.0.0",
    "@lumeland/plugin-feed": "1.0.0",
    "@lumeland/plugin-git-date": "1.0.0",
    "@lumeland/plugin-git-info": "1.0.0",
    "@lumeland/plugin-google-fonts": "1.0.0",
    "@lumeland/plugin-icons": "1.0.0",
    "@lumeland/plugin-image-size": "1.0.0",
    "@lumeland/plugin-inline": "1.0.0",
    "@lumeland/plugin-json-ld": "1.0.0",
    "@lumeland/plugin-lightningcss": "1.0.0",
    "@lumeland/plugin-metas": "1.0.0",
    "@lumeland/plugin-minify-html": "1.0.0",
    "@lumeland/plugin-multilanguage": "1.0.0",
    "@lumeland/plugin-nav": "1.0.0",
    "@lumeland/plugin-pagefind": "1.0.0",
    "@lumeland/plugin-picture": "1.0.0",
    "@lumeland/plugin-pwa": "1.0.0",
    "@lumeland/plugin-redirects": "1.0.0",
    "@lumeland/plugin-remark": "1.0.1",
    "@lumeland/plugin-robots": "1.0.0",
    "@lumeland/plugin-sass": "1.0.0",
    "@lumeland/plugin-seo": "1.0.1",
    "@lumeland/plugin-sitemap": "1.0.0",
    "@lumeland/plugin-slugify-urls": "1.0.0",
    "@lumeland/plugin-svgo": "1.0.0",
    "@lumeland/plugin-transform-images": "1.0.0",
    "@lumeland/plugin-validate-html": "1.0.0",
    "@lumeland/plugin-well-known": "1.0.0",
    "@myriaddreamin/typst-ts-node-compiler": "0.8.0-rc3",
    "@serwist/build": "9.5.13",
    "@shikijs/rehype": "^4.5.0",
    "esbuild": "0.28.2",
    "image-dimensions": "2.6.0",
    "leaflet": "^1.9.4",
    "photoswipe": "^5.4.4",
    "protomaps-leaflet": "5.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-smartypants": "^3.0.3",
    "remark-toc": "^9.0.0",
    "serwist": "^9.5.13",
